{
  "schemaVersion": 1,
  "id": "phone",
  "name": "Hhub 手机遥控",
  "author": "H hub",
  "version": "1.0.9",
  "apiVersion": "1.0",
  "kind": "application",
  "description": "通过手机配对与授权，远程控制 Hhub 的场景、音频和兼容设备；支持撤销配对及细分权限。",
  "nativePage": "phone",
  "requiredHost": {
    "id": "hhub",
    "apiVersion": "1.0",
    "execution": "host-only",
    "standalone": false,
    "minimumVersion": "1.0.9"
  },
  "permissions": [
    "本机局域网服务",
    "手机配对授权"
  ],
  "updateUrl": "",
  "compatibility": {
    "version": 1,
    "scope": "tool",
    "deviceName": "",
    "hardwareId": "",
    "firmwareVersions": [],
    "mobileUi": false
  },
  "implementation": {
    "type": "host-native-feature",
    "notes": "调用 Hhub 已有原生页面与后台服务，不包含可独立执行的引擎或手机应用。"
  }
}
