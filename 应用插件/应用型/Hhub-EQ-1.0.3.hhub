{
  "schemaVersion": 1,
  "id": "eq",
  "name": "Hhub 通用 EQ",
  "author": "H hub",
  "version": "1.0.3",
  "apiVersion": "1.0",
  "kind": "application",
  "description": "按输出设备和应用调节 EQ，使用 FxSound 原厂预设与音效；虚拟音频驱动可单独安装。",
  "nativePage": "eq",
  "requiredHost": {
    "id": "hhub",
    "apiVersion": "1.0",
    "execution": "host-only",
    "standalone": false,
    "minimumVersion": "1.0.9"
  },
  "permissions": [
    "应用音频路由",
    "音频输出配置"
  ],
  "updateUrl": "",
  "compatibility": {
    "version": 1,
    "scope": "tool",
    "deviceName": "",
    "hardwareId": "",
    "firmwareVersions": [],
    "mobileUi": false
  },
  "implementation": {
    "type": "host-native-feature",
    "notes": "调用 Hhub 已有原生页面与后台服务，不包含可独立执行的引擎或手机应用。"
  }
}
