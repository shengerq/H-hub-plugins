{
  "schemaVersion": 1,
  "id": "hhub.rog-falchion-ace-hfx",
  "name": "ROG 魔导士 ACE HFX",
  "deviceName": "ROG 魔导士 ACE HFX",
  "author": "H hub",
  "version": "0.1.0",
  "apiVersion": "1.0",
  "kind": "keyboard",
  "description": "ACE HFX 有线版：触发、死区、RT、改键、Speed Tap、灯光和回报率。依据官方协议实现，待真机验收。",
  "permissions": [
    "离线插件页面",
    "USB HID 配置"
  ],
  "requiredHost": {
    "id": "hhub",
    "apiVersion": "1.0",
    "execution": "host-only",
    "standalone": false,
    "hidTransportVersion": 2
  },
  "ui": {
    "type": "offline-html",
    "role": "device",
    "content": "<!doctype html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>魔导士 ACE HFX · H-hub</title><style>:root{font-family:'Segoe UI Variable','Microsoft YaHei',sans-serif;color:#202832;background:#f4f6f8;color-scheme:light;--accent:#106b65;--bg:#f4f6f8;--card:#fff;--line:#dfe4e8;--muted:#697582;--text:#202832;--control:#fff}\n*{box-sizing:border-box}body{margin:0}main{max-width:1160px;margin:auto;padding:28px}button,input,select{font:inherit;color:inherit}button{cursor:pointer}button,input,select{min-height:38px;border:1px solid var(--line);border-radius:7px;background:var(--control);padding:8px 12px}button:hover{border-color:var(--accent)}button.primary{background:var(--accent);border-color:var(--accent);color:white}button:disabled,fieldset:disabled{opacity:.48;cursor:default}button:disabled:hover{border-color:var(--line)}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #58aaa599;outline-offset:2px}h1,h2,h3,p{margin:0}h1{font-size:24px;font-weight:650}h2{font-size:17px}p{line-height:1.65}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--accent);font-weight:700;margin-bottom:7px}.subtitle,.hint{color:var(--muted);font-size:13px}.subtitle{margin-top:8px}.top,.row,.actions,.card-head{display:flex;align-items:center;gap:12px}.top,.card-head{justify-content:space-between;flex-wrap:wrap}.actions{flex-wrap:wrap}.actions button{min-width:112px}.badge{font-size:12px;padding:5px 9px;border-radius:16px;background:#e8efef;color:var(--accent)}.card{background:var(--card);border:1px solid var(--line);padding:22px;border-radius:12px;margin-top:18px}.status{font-size:13px;min-height:21px;margin:12px 0 0;color:var(--muted)}.status.error{color:#b94242}.status.ok{color:var(--accent)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:20px 0 4px}.stats label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px}.stats strong{font-size:18px;font-weight:600}.keyboard{display:grid;gap:6px;margin:20px 0 12px;overflow-x:auto;padding:3px}.key-row{display:flex;gap:5px;min-width:680px}.key{padding:9px 1px;font-size:12px;flex:1;min-width:0;height:42px;box-shadow:0 2px 0 #00000008;border-radius:6px}.key.selected{border:2px solid var(--accent);background:#e6f2ef;color:var(--accent);font-weight:650}.key.space{flex:6.2}.key.wide{flex:1.65}.key.extrawide{flex:2.1}.key.fn{color:var(--muted)}.selection{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}.selection strong{font-size:14px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.grid .card{margin-top:0}.grid-wrap{margin-top:18px}.field{margin-top:20px}.field>label{display:block;font-size:13px;margin-bottom:8px}.field input[type=number]{width:100px}.field select{width:100%;max-width:280px}.field input[type=range]{padding:0;accent-color:var(--accent);flex:1;min-width:80px}.field input[type=color]{width:64px;padding:4px}.field .hint{margin-top:7px}.switch{display:flex;align-items:center;gap:9px;cursor:pointer;font-size:14px}.switch input{appearance:none;min-height:22px;width:38px;height:22px;padding:2px;border:0;border-radius:20px;background:#c6cdd3;position:relative;cursor:pointer}.switch input:before{content:'';position:absolute;width:18px;height:18px;background:white;border-radius:50%;left:2px;top:2px;box-shadow:0 1px 3px #0002}.switch input:checked{background:var(--accent)}.switch input:checked:before{left:18px}.card .actions{margin-top:20px}fieldset{padding:0;border:0;margin:0;min-width:0}.section-tag{font-size:11px;font-weight:600;color:var(--muted);letter-spacing:1px}.inline-fields{display:flex;gap:18px;flex-wrap:wrap}.inline-fields .field{flex:1;min-width:130px}.pairs{font-size:12px;color:var(--muted);min-height:20px;margin-top:9px}.bottom{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center}details{margin-top:18px;color:var(--muted);font-size:13px}summary{cursor:pointer}details p{margin-top:9px}.downloads{margin-top:12px;display:flex;gap:8px;flex-wrap:wrap}.downloads button{font-size:12px}.footer{color:var(--muted);font-size:12px;margin:18px 2px;line-height:1.8}output{font-variant-numeric:tabular-nums}.hidden{display:none!important}.devices{margin-top:14px;display:flex;gap:10px;align-items:center}.devices select{flex:1}.notice{background:#f7f1df;border-radius:8px;padding:12px 14px;font-size:13px;line-height:1.7;margin-top:18px;color:#796637}\n:root[data-hhub-theme=dark]{--accent:#71c4b6;--bg:#181d23;--card:#232a32;--line:#3c4652;--text:#eff3f6;--muted:#acb7c4;--control:#29313b;color:var(--text);background:var(--bg);color-scheme:dark}:root[data-hhub-theme=dark] .key.selected{background:#21483f}:root[data-hhub-theme=dark] .notice{background:#393326;color:#e1cf9a}\n@media(max-width:760px){main{padding:16px}.grid{grid-template-columns:1fr}.card{padding:16px}.stats{grid-template-columns:repeat(2,1fr)}.top{align-items:flex-start}.actions button{min-width:98px}.keyboard{margin-top:15px}}\n@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}:root[data-hhub-reduce-motion=true] *{animation:none!important;transition:none!important}\n</style></head>\n<body><main>\n  <header class=\"top\"><div><div class=\"eyebrow\">H-HUB / KEYBOARD</div><h1>魔导士 ACE HFX</h1><p class=\"subtitle\">65% 磁轴键盘 <span aria-hidden=\"true\">·</span> <span id=\"transport-label\">独立 WebHID 驱动</span></p></div><div class=\"actions\"><span class=\"badge\" id=\"connection-badge\">未连接</span><button class=\"primary\" id=\"connect\">连接键盘</button><button id=\"disconnect\" disabled>断开</button></div></header>\n  <p id=\"global-status\" role=\"status\" aria-live=\"polite\" class=\"status\">先连接键盘，所有参数均从设备读取。</p>\n  <div class=\"devices hidden\" id=\"device-picker\"><label for=\"devices\">选择键盘</label><select id=\"devices\"></select><button id=\"choose-device\">连接所选设备</button></div>\n  <div class=\"card\"><div class=\"card-head\"><h2>设备与按键</h2><button id=\"refresh\" data-device disabled>重新读取</button></div>\n    <div class=\"stats\"><div><label>固件版本</label><strong id=\"firmware\">—</strong></div><div><label>回报率</label><strong id=\"polling-value\">—</strong></div><div><label>全键触发</label><strong id=\"ap-value\">—</strong></div><div><label>板载配置</label><strong id=\"profile-value\">—</strong></div></div>\n    <div class=\"keyboard\" id=\"keyboard\" role=\"group\" aria-label=\"65% ANSI 键盘按键选择\"></div>\n    <div class=\"selection\"><strong>当前按键：<span id=\"selected-key\">W</span></strong><span class=\"hint\" id=\"key-summary\">连接后读取单键参数</span></div>\n  </div>\n  <div class=\"grid grid-wrap\">\n    <section class=\"card\"><div class=\"card-head\"><h2>触发与死区</h2><span class=\"section-tag\">0.1 MM 步进</span></div><fieldset data-device disabled>\n      <div class=\"field\"><label for=\"scope\">调整范围</label><select id=\"scope\"><option value=\"key\">当前按键</option><option value=\"all\">全键基础参数</option></select></div>\n      <div class=\"field\"><label for=\"ap\">触发行程</label><div class=\"row\"><input type=\"range\" id=\"ap-range\" min=\"0.1\" max=\"4\" step=\"0.1\" value=\"1\"><input type=\"number\" id=\"ap\" min=\"0.1\" max=\"4\" step=\"0.1\" value=\"1\" aria-label=\"触发行程毫米\"><span>mm</span></div></div>\n      <div class=\"inline-fields\"><div class=\"field\"><label for=\"dz-top\">顶部死区 · mm</label><input type=\"number\" id=\"dz-top\" min=\"0\" max=\"0.5\" step=\"0.1\" value=\"0.2\"></div><div class=\"field\"><label for=\"dz-bottom\">底部死区 · mm</label><input type=\"number\" id=\"dz-bottom\" min=\"0\" max=\"0.5\" step=\"0.1\" value=\"0.2\"></div></div>\n      <div class=\"actions\"><button class=\"primary\" id=\"apply-ap\">应用触发行程</button><button id=\"apply-dz\">应用死区</button></div><p class=\"status\" id=\"mag-status\" role=\"status\"></p>\n    </fieldset></section>\n    <section class=\"card\"><div class=\"card-head\"><h2>Rapid Trigger</h2><label class=\"switch\"><input type=\"checkbox\" id=\"rt-switch\" data-device disabled><span>RT 总开关</span></label></div><fieldset data-device disabled>\n      <div class=\"field\"><label class=\"switch\"><input type=\"checkbox\" id=\"rt-key-enabled\" checked><span>为选中按键启用 RT</span></label></div>\n      <div class=\"field\"><label for=\"rt-sensitivity\">按下 / 释放灵敏度</label><div class=\"row\"><input type=\"range\" id=\"rt-range\" min=\"0.1\" max=\"2.5\" step=\"0.1\" value=\"0.2\"><input type=\"number\" id=\"rt-sensitivity\" min=\"0.1\" max=\"2.5\" step=\"0.1\" value=\"0.2\" aria-label=\"RT 灵敏度毫米\"><span>mm</span></div></div>\n      <div class=\"field\"><label class=\"switch\"><input type=\"checkbox\" id=\"rt-continuous\"><span>连续快速触发</span></label></div>\n      <div class=\"actions\"><button class=\"primary\" id=\"apply-rt\">应用到当前按键</button><button id=\"apply-wasd\">应用到 WASD</button></div><p class=\"status\" id=\"rt-status\" role=\"status\">灵敏度为待写入值；应用后读取设备确认。</p>\n    </fieldset></section>\n    <section class=\"card\"><h2>按键映射</h2><fieldset data-device disabled><div class=\"field\"><label for=\"target-key\">将当前按键映射为</label><select id=\"target-key\"></select><p class=\"hint\">仅修改主层映射，不修改现有触发行程。</p></div><div class=\"actions\"><button class=\"primary\" id=\"apply-binding\">应用映射</button><button id=\"restore-binding\">恢复此键</button></div><p class=\"status\" id=\"binding-status\" role=\"status\"></p></fieldset></section>\n    <section class=\"card\"><div class=\"card-head\"><h2>Speed Tap</h2><label class=\"switch\"><input type=\"checkbox\" id=\"speed-switch\" data-device disabled><span>启用</span></label></div><fieldset data-device disabled><div class=\"inline-fields\"><div class=\"field\"><label for=\"pair-a\">按键一</label><select id=\"pair-a\"></select></div><div class=\"field\"><label for=\"pair-b\">按键二</label><select id=\"pair-b\"></select></div></div><div class=\"actions\"><button class=\"primary\" id=\"add-pair\">添加配对</button><button id=\"remove-pair\">移除此配对</button></div><p class=\"pairs\" id=\"pairs\">连接后读取现有配对</p><p class=\"status\" id=\"speed-status\" role=\"status\"></p></fieldset></section>\n    <section class=\"card\"><h2>灯光</h2><fieldset data-device disabled><div class=\"field\"><label for=\"light-type\">灯效</label><select id=\"light-type\"><option value=\"0\">静态</option><option value=\"1\">呼吸</option><option value=\"2\">色彩循环</option></select></div><div class=\"field\"><label for=\"brightness\">亮度</label><div class=\"row\"><input type=\"range\" id=\"brightness\" min=\"0\" max=\"100\" step=\"1\" value=\"50\"><output id=\"brightness-label\">50%</output><input type=\"color\" id=\"color\" value=\"#31a994\" aria-label=\"灯光颜色\"></div></div><div class=\"field\"><label for=\"light-speed\">速度</label><select id=\"light-speed\"><option value=\"0\">慢</option><option value=\"1\" selected>中</option><option value=\"2\">快</option></select></div><div class=\"actions\"><button class=\"primary\" id=\"apply-light\">应用灯光</button><button id=\"read-light\">读取此灯效</button></div><p class=\"status\" id=\"light-status\" role=\"status\">应用后回读所选灯效配置。</p></fieldset></section>\n    <section class=\"card\"><h2>回报率与板载保存</h2><fieldset data-device disabled><div class=\"field\"><label for=\"polling\">USB 回报率</label><select id=\"polling\"><option value=\"1000\">1000 Hz</option><option value=\"8000\">8000 Hz</option></select></div><div class=\"actions\"><button class=\"primary\" id=\"apply-polling\">应用回报率</button></div><p class=\"status\" id=\"polling-status\" role=\"status\"></p><div class=\"field\"><label>板载配置</label><p class=\"hint\">将当前参数保存到当前板载配置。断电后的保留情况需重新插拔确认。</p></div><div class=\"actions\"><button id=\"save-device\">保存到键盘</button></div><p class=\"status\" id=\"save-status\" role=\"status\"></p></fieldset></section>\n  </div>\n  <details><summary>官方资料与诊断</summary><p>目标设备：ROG FALCHION ACE HFX / M605，USB 0B05:1B7E。此版本依据官方网页协议实现，尚未完成真机验收。连接失败时可退出占用设备的奥创 / Gear Link，再重新连接。</p><div class=\"downloads\"><button data-link=\"product\">产品官网</button><button data-link=\"support\">官方驱动下载</button><button data-link=\"gearlink\">奥创极速网页版</button><button data-link=\"faq\">官方使用说明</button><button id=\"export-log\">导出诊断</button></div><p>宏、DKS、校准、固件刷写和自动场景切换暂未实现。诊断仅包含此页面的有限 HID 报文及设备版本信息。</p></details>\n  <p class=\"footer\">独立开发的 H-hub 插件 · v0.1.0 · 仅识别 ACE HFX 有线版<br>界面修改不会自动发送；点击对应应用按钮后才写入设备。</p>\n</main><script>/* Original adapter. Protocol constants researched from ASUS Gear Link M605 1.00.28.\n * See docs/PROTOCOL.md for the model-specific legacy encoding and source offsets. */\n(function (root) {\n  'use strict';\n  const ID = Object.freeze({ vendorId: 0x0b05, productId: 0x1b7e, usagePage: 0xff00, usage: 1, reportId: 0, payloadLength: 64 });\n  // ASUS firmware matrix positions; these are NOT USB keyboard usage IDs.\n  const KEYS = Object.freeze({\n    Escape:110, Backquote:1, Digit1:2, Digit2:3, Digit3:4, Digit4:5, Digit5:6, Digit6:7, Digit7:8, Digit8:9, Digit9:10, Digit0:11,\n    Minus:12, Equal:13, Backspace:15, Tab:16, KeyQ:17, KeyW:18, KeyE:19, KeyR:20, KeyT:21, KeyY:22, KeyU:23, KeyI:24, KeyO:25, KeyP:26,\n    BracketLeft:27, BracketRight:28, Backslash:29, CapsLock:30, KeyA:31, KeyS:32, KeyD:33, KeyF:34, KeyG:35, KeyH:36, KeyJ:37, KeyK:38, KeyL:39,\n    Semicolon:40, Quote:41, Enter:43, ShiftLeft:44, KeyZ:46, KeyX:47, KeyC:48, KeyV:49, KeyB:50, KeyN:51, KeyM:52, Comma:53, Period:54, Slash:55,\n    ShiftRight:57, ControlLeft:58, MetaLeft:59, AltLeft:60, Space:61, AltRight:62, ControlRight:64, FN:159,\n    Insert:75, Delete:76, Home:80, End:81, PageUp:85, PageDown:86, ArrowLeft:79, ArrowUp:83, ArrowDown:84, ArrowRight:89,\n    F1:112, F2:113, F3:114, F4:115, F5:116, F6:117, F7:118, F8:119, F9:120, F10:121, F11:122, F12:123,\n    AV_PlayPause:183, AV_Mute:184, AV_VolUp:187, AV_VolDown:188, Disabled:0\n  });\n  const PHYSICAL = Object.freeze([\n    ['Escape','Digit1','Digit2','Digit3','Digit4','Digit5','Digit6','Digit7','Digit8','Digit9','Digit0','Minus','Equal','Backspace','Delete'],\n    ['Tab','KeyQ','KeyW','KeyE','KeyR','KeyT','KeyY','KeyU','KeyI','KeyO','KeyP','BracketLeft','BracketRight','Backslash','PageUp'],\n    ['CapsLock','KeyA','KeyS','KeyD','KeyF','KeyG','KeyH','KeyJ','KeyK','KeyL','Semicolon','Quote','Enter','PageDown'],\n    ['ShiftLeft','KeyZ','KeyX','KeyC','KeyV','KeyB','KeyN','KeyM','Comma','Period','Slash','ShiftRight','ArrowUp','End'],\n    ['ControlLeft','MetaLeft','AltLeft','Space','AltRight','FN','ControlRight','ArrowLeft','ArrowDown','ArrowRight']\n  ]);\n  const MAGNETIC = new Set(PHYSICAL.flat().filter(k => k !== 'FN'));\n  function integer(value, min, max, label) {\n    if (!Number.isInteger(value) || value < min || value > max) throw new RangeError(`${label}超出范围 ${min}–${max}`);\n    return value;\n  }\n  function boolean(value) { if (typeof value !== 'boolean') throw new TypeError('开关值必须是布尔值'); return value ? 1 : 0; }\n  function unit(mm, min = 0.1, max = 4) {\n    if (typeof mm !== 'number' || !Number.isFinite(mm) || mm < min || mm > max || Math.abs(mm * 10 - Math.round(mm * 10)) > 1e-7)\n      throw new RangeError(`行程须为 ${min}–${max} mm，步进 0.1 mm`);\n    return Math.round(mm * 10);\n  }\n  const le = n => [n & 255, n >>> 8 & 255];\n  function keyCode(key, physical = false) {\n    if (!Object.hasOwn(KEYS, key) || physical && !MAGNETIC.has(key)) throw new RangeError(`不支持的按键：${key}`);\n    return KEYS[key];\n  }\n  const readPairs = new Set(['18:0','18:2','18:18','18:21','37:0','37:1','37:2','37:4','37:5','37:6','37:8','37:9','37:10','37:13','37:14']);\n  const writePairs = new Set(['81:32','81:44','81:49','81:79','81:80','81:84','81:85','81:87','81:88','81:89','81:92','80:85']);\n  function validateFrame(data) {\n    if (!(data instanceof Uint8Array) || data.length !== 64 || !(readPairs.has(`${data[0]}:${data[1]}`) || writePairs.has(`${data[0]}:${data[1]}`)))\n      throw new Error('报文不在 ACE HFX 已实现命令范围内');\n    return data;\n  }\n  function frame(command, subcommand, index = 0, data = []) {\n    integer(index, 0, 65535, '索引');\n    if (data.length > 60 || data.some(n => !Number.isInteger(n) || n < 0 || n > 255)) throw new RangeError('报文数据无效');\n    const bytes = new Uint8Array(64);\n    bytes.set([command, subcommand, ...le(index), ...data]);\n    return validateFrame(bytes);\n  }\n  const commands = Object.freeze({\n    info: () => frame(0x12, 0), layout: () => frame(0x12, 0x12),\n    polling: () => frame(0x12, 0x15),\n    setPolling(hz) { const index = ({1000:0, 8000:3})[hz]; if (index === undefined) throw new RangeError('ACE HFX 此版仅提供官方页面中的 1000 / 8000 Hz'); return frame(0x51, 0x31, 0, [index]); },\n    actuation: key => frame(0x25, key == null ? 5 : 4, 0, key == null ? [] : le(keyCode(key, true))),\n    setActuation: (mm, key) => frame(0x51, key == null ? 0x50 : 0x4f, 0, [...key == null ? [] : le(keyCode(key, true)), ...le(unit(mm))]),\n    deadZone: key => frame(0x25, key == null ? 10 : 9, 0, key == null ? [] : le(keyCode(key, true))),\n    setDeadZone: (top, bottom, key) => frame(0x51, key == null ? 0x58 : 0x59, 0, [...key == null ? [] : le(keyCode(key, true)), unit(bottom, 0, 0.5), unit(top, 0, 0.5)]),\n    rapidState: () => frame(0x25, 0), setRapidState: enabled => frame(0x51, 0x5c, 0, [boolean(enabled)]),\n    rapidKey: key => frame(0x25, 6, 0, le(keyCode(key, true))),\n    // M605 inherits tr -> xn: 8-bit sensitivity, then continuous and enabled.\n    // Newer ROG keyboards use a different layout here. Never substitute that layout.\n    setRapidKey(key, {enabled, sensitivity, continuous = false}) {\n      return frame(0x51, 0x54, 0, [...le(keyCode(key, true)), unit(sensitivity, 0.1, 2.5), boolean(continuous), boolean(enabled)]);\n    },\n    speedState: () => frame(0x25, 1), setSpeedState: enabled => frame(0x51, 0x57, 0, [boolean(enabled)]),\n    speedPairs: page => frame(0x25, 8, integer(page, 0, 1, 'Speed Tap 页')),\n    setSpeedPair(a, b, enabled) { if (a === b) throw new RangeError('Speed Tap 需要两个不同按键'); return frame(0x51, 0x55, 0, [...le(keyCode(a, true)), ...le(keyCode(b, true)), boolean(enabled)]); },\n    binding: key => frame(0x25, 0x0d, 0, le(keyCode(key, true))),\n    setBinding: (source, t