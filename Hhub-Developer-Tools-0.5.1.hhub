{
    "schemaVersion":  1,
    "id":  "hhub.developer-tools",
    "name":  "H hub 开发者工具",
    "author":  "H hub",
    "version":  "0.5.1",
    "apiVersion":  "1.0",
    "permissions":  [
                        "离线插件页面",
                        "用户选择的抓包文件",
                        "项目文件导入与导出",
                        "USB HID 配置"
                    ],
    "updateUrl":  "",
    "ui":  {
               "type":  "offline-html",
               "role":  "developer-tools",
               "categories":  [
                                  "mouse",
                                  "keyboard",
                                  "audio",
                                  "gamepad"
                              ],
               "content":  "\u003c!doctype html\u003e\u003chtml lang=\"zh-CN\"\u003e\u003chead\u003e\u003cmeta charset=\"UTF-8\"\u003e\u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"\u003e\n\u003ctitle\u003eH hub 开发者工具\u003c/title\u003e\u003cstyle\u003e\n:root{color-scheme:dark;--bg:#222;--panel:#2b2b2b;--text:#f5f5f5;--muted:#aaa;--line:#414141;--accent:#70bdf4} :root[data-theme=light]{color-scheme:light;--bg:#fafafa;--panel:#fff;--text:#222;--muted:#666;--line:#ddd;--accent:#0078d4}\n*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px \u0027Segoe UI\u0027,\u0027Microsoft YaHei\u0027,sans-serif}header{padding:4px 2px 18px}h1{font-size:22px;margin:0 0 8px}h2{font-size:17px;margin:22px 0 12px}p{color:var(--muted);line-height:1.7;margin:6px 0}.tag{font-size:12px;color:var(--accent)}details{background:var(--panel);border:1px solid var(--line);border-radius:8px;margin-bottom:12px}summary{cursor:pointer;padding:19px;font-size:17px;user-select:none}summary small{display:inline-block;color:var(--muted);font-size:12px;margin-left:18px}.environment{padding:0 20px 22px}.steps{display:flex;gap:8px;flex-wrap:wrap;padding:8px 0}.steps span{padding:6px 10px;border:1px solid var(--line);border-radius:4px;color:var(--muted);font-size:12px}.fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}label{display:block;color:var(--muted);font-size:12px}input,select,textarea,button{font:inherit}input,select,textarea{display:block;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:4px;padding:9px;margin-top:6px;width:100%}input[type=checkbox]{width:auto;display:inline;margin-right:7px}button{border:1px solid var(--line);border-radius:4px;background:var(--bg);color:var(--text);padding:9px 13px;cursor:pointer;margin-top:10px}button.primary{background:var(--accent);color:#101010;border-color:var(--accent)}button:hover{filter:brightness(1.12)}textarea{min-height:120px;font:12px Consolas,monospace;line-height:1.5;resize:vertical}.actions{display:flex;gap:10px;flex-wrap:wrap}.preview{padding:14px;border:1px solid var(--line);border-radius:6px;margin-top:12px}.preview label{margin-bottom:10px}.preview output{color:var(--accent)}pre{white-space:pre-wrap;overflow-wrap:anywhere;color:var(--muted);font:12px Consolas,monospace;max-height:220px;overflow:auto;padding:12px;border:1px solid var(--line);border-radius:4px}iframe{width:100%;height:250px;border:1px solid var(--line);margin-top:10px;background:#fff}.status{min-height:24px;color:var(--accent);line-height:1.6;padding-top:10px}.status.error{color:#ff9090}.check{margin:12px 0}.check input{display:inline}footer{padding:10px 2px;font-size:12px;color:var(--muted)}@media(max-width:600px){.fields{grid-template-columns:1fr}summary small{display:block;margin:8px 0 0}}\n\u003c/style\u003e\u003c/head\u003e\u003cbody\u003e\u003cheader\u003e\u003ch1\u003e插件开发工作台\u003c/h1\u003e\u003cp\u003e从页面模板到协议绑定，在同一环境中完成项目、抓包对照与打包。选择一种外设开始。\u003c/p\u003e\u003cspan class=\"tag\"\u003e独立安装 · 离线工作 · 四类外设\u003c/span\u003e\u003c/header\u003e\u003cmain id=\"environments\"\u003e\u003c/main\u003e\u003cfooter\u003e模板定义页面层。报文来自你对官方驱动的抓包与真机验证，差异结果只是候选字段；本工具不向硬件写入命令。\u003c/footer\u003e\n\u003cscript\u003e/* H hub developer tools: offline project, capture and packet mapping logic. */\nconst HhubDev = (() =\u003e {\n  const templates = [\n    {kind:\u0027mouse\u0027,name:\u0027鼠标\u0027,description:\u0027DPI、回报率、按键与自定义功能\u0027,controls:[{id:\u0027dpi\u0027,label:\u0027DPI\u0027,type:\u0027number\u0027,min:100,max:32000,value:1600},{id:\u0027pollingRate\u0027,label:\u0027回报率\u0027,type:\u0027number\u0027,min:125,max:8000,value:1000},{id:\u0027custom\u0027,label:\u0027自定义按钮\u0027,type:\u0027button\u0027}]},\n    {kind:\u0027keyboard\u0027,name:\u0027键盘\u0027,description:\u0027触发、灯光、按键与自定义功能\u0027,controls:[{id:\u0027actuation\u0027,label:\u0027触发距离\u0027,type:\u0027number\u0027,min:0.1,max:4,value:1.5},{id:\u0027rapidTrigger\u0027,label:\u0027快速触发\u0027,type:\u0027toggle\u0027,value:false},{id:\u0027brightness\u0027,label:\u0027灯光亮度\u0027,type:\u0027number\u0027,min:0,max:100,value:50},{id:\u0027custom\u0027,label:\u0027自定义按钮\u0027,type:\u0027button\u0027}]},\n    {kind:\u0027audio\u0027,name:\u0027耳机 / 音频\u0027,description:\u0027音量、硬件音效与连接方式\u0027,controls:[{id:\u0027volume\u0027,label:\u0027音量\u0027,type:\u0027number\u0027,min:0,max:100,value:50},{id:\u0027micMute\u0027,label:\u0027麦克风静音\u0027,type:\u0027toggle\u0027,value:false},{id:\u0027custom\u0027,label:\u0027自定义按钮\u0027,type:\u0027button\u0027}]},\n    {kind:\u0027gamepad\u0027,name:\u0027手柄\u0027,description:\u0027摇杆、扳机、振动与自定义功能\u0027,controls:[{id:\u0027deadzone\u0027,label:\u0027摇杆死区\u0027,type:\u0027number\u0027,min:0,max:100,value:8},{id:\u0027trigger\u0027,label:\u0027扳机死区\u0027,type:\u0027number\u0027,min:0,max:100,value:5},{id:\u0027vibration\u0027,label:\u0027振动强度\u0027,type:\u0027number\u0027,min:0,max:100,value:60},{id:\u0027custom\u0027,label:\u0027自定义按钮\u0027,type:\u0027button\u0027}]}\n  ];\n  const clone = value =\u003e JSON.parse(JSON.stringify(value));\n  function hex(value) {\n    const text=String(value).replace(/0x/gi,\u0027\u0027).replace(/[\\s:\\-]/g,\u0027\u0027);\n    if(!text || text.length%2 || !/^[0-9a-f]+$/i.test(text) || text.length\u003e8192) throw Error(\u0027报文应为完整的十六进制字节，最多 4096 字节\u0027);\n    return text.match(/../g).map(byte=\u003eparseInt(byte,16));\n  }\n  const format = bytes =\u003e bytes.map(byte=\u003ebyte.toString(16).padStart(2,\u00270\u0027).toUpperCase()).join(\u0027 \u0027);\n  function csv(text) {\n    const rows=[];let row=[],field=\u0027\u0027,quoted=false;\n    for(let i=0;i\u003ctext.length;i++) { const c=text[i];\n      if(c===\u0027\"\u0027) {if(quoted\u0026\u0026text[i+1]===\u0027\"\u0027){field+=\u0027\"\u0027;i++;}else quoted=!quoted;}\n      else if(!quoted\u0026\u0026(c===\u0027,\u0027||c===\u0027\\n\u0027)) {row.push(field.trim());field=\u0027\u0027;if(c===\u0027\\n\u0027){if(row.some(Boolean))rows.push(row);row=[];}}\n      else if(c!==\u0027\\r\u0027)field+=c;\n    }\n    if(quoted)throw Error(\u0027CSV 引号未闭合\u0027);row.push(field.trim());if(row.some(Boolean))rows.push(row);return rows;\n  }\n  function frame(record) {\n    if(typeof record===\u0027string\u0027){\n      const match=record.match(/^usagePage:(\\d+|\\?)\\s+usage:(\\d+|\\?)\\s+(OUT|IN|sendFeature|receiveFeature|feature)\\s+ID:(\\d+)\\s+(.+)$/i);\n      if(!match)throw Error(\u0027WebHID Workbench 报文行格式不匹配\u0027);\n      const reportId=Number(match[4]);if(reportId\u003e255)throw Error(\u0027HID Report ID 超出范围\u0027);\n      return {payload:format(hex(match[5])),endpoint:match[1]===\u0027?\u0027||match[2]===\u0027?\u0027?\u0027\u0027:\u0027hid:\u0027+match[1]+\u0027:\u0027+match[2],direction:match[3].toLowerCase(),reportId:String(reportId),usagePage:match[1]===\u0027?\u0027?null:Number(match[1]),usage:match[2]===\u0027?\u0027?null:Number(match[2]),source:\u0027ClickSync WebHID Workbench\u0027};\n    }\n    const layers=record?._source?.layers;\n    const usb=layers?.usb||{};const hid=layers?.usbhid||{};\n    const payload=record.payload??usb[\u0027usb.capdata\u0027]??usb[\u0027usb.data_fragment\u0027]??hid[\u0027usbhid.data\u0027]??layers?.[\u0027usb.capdata\u0027];\n    if(payload===undefined)return null;\n    return {payload:format(hex(Array.isArray(payload)?payload[0]:payload)),endpoint:String(record.endpoint??usb[\u0027usb.endpoint_address\u0027]??\u0027\u0027),direction:String(record.direction??\u0027\u0027),reportId:String(record.reportId??hid[\u0027usbhid.report_id\u0027]??\u0027\u0027)};\n  }\n  function parseCapture(text) {\n    if(typeof text!==\u0027string\u0027||text.length\u003e2*1024*1024)throw Error(\u0027抓包导出文件不能超过 2 MB\u0027);\n    text=text.replace(/^\\uFEFF/,\u0027\u0027).trim();let frames;\n    if(text.startsWith(\u0027[\u0027)||text.startsWith(\u0027{\u0027)) {\n      const data=JSON.parse(text);const snapshots=Array.isArray(data.snapshots)?data.snapshots:null;\n      const records=Array.isArray(data)?data:snapshots?snapshots.flatMap(s=\u003e{if(!Array.isArray(s.packets))throw Error(\u0027抓包快照缺少 packets 数组\u0027);return s.packets}):data.packets;\n      if(!Array.isArray(records))throw Error(\u0027JSON 需要报文数组或 packets 数组\u0027);frames=records.map(frame).filter(Boolean);\n      if(snapshots){let cursor=0;for(const snapshot of snapshots)for(const packet of snapshot.packets){const entry=frames[cursor++];if(!entry)continue;entry.snapshotNumber=snapshot.n;entry.snapshotNote=snapshot.note||\u0027\u0027;entry.vid=data.device?.vid;entry.pid=data.device?.pid;}}\n    } else if(text.split(\u0027\\n\u0027)[0].includes(\u0027,\u0027)) {\n      const rows=csv(text),headers=rows.shift().map(h=\u003eh.toLowerCase());const index=headers.indexOf(\u0027payload\u0027);\n      if(index\u003c0)throw Error(\u0027CSV 必须含 payload 列\u0027);\n      frames=rows.map(row=\u003eframe({payload:row[index],endpoint:row[headers.indexOf(\u0027endpoint\u0027)]||\u0027\u0027,direction:row[headers.indexOf(\u0027direction\u0027)]||\u0027\u0027,reportId:row[headers.indexOf(\u0027reportid\u0027)]||\u0027\u0027}));\n    } else frames=text.split(/\\r?\\n/).filter(Boolean).map(payload=\u003eframe({payload}));\n    if(!frames.length||frames.length\u003e2000)throw Error(\u0027需要 1–2000 条包含 USB 数据负载的报文\u0027);return frames;\n  }\n  function compare(before,after) {\n    for(const key of [\u0027endpoint\u0027,\u0027direction\u0027,\u0027reportId\u0027])if(before[key]\u0026\u0026after[key]\u0026\u0026before[key]!==after[key])throw Error(\u0027两条报文的 \u0027+key+\u0027 不同，请选择同一通道\u0027);\n    const a=hex(before.payload),b=hex(after.payload);if(a.length!==b.length)throw Error(\u0027报文长度不同，不能直接绑定字节偏移\u0027);\n    const changes=[];for(let i=0;i\u003ca.length;i++)if(a[i]!==b[i])changes.push({offset:i,before:a[i],after:b[i]});\n    return {changes,length:a.length,identityConfirmed:!!(before.endpoint\u0026\u0026after.endpoint\u0026\u0026before.direction\u0026\u0026after.direction)};\n  }\n  function validateControls(controls) {\n    if(!Array.isArray(controls)||!controls.length||controls.length\u003e64)throw Error(\u0027UI 需要 1–64 个控件\u0027);const ids=new Set();\n    for(const c of controls) {\n      if(!/^[a-z][a-z0-9_-]{0,39}$/i.test(c.id)||ids.has(c.id)||typeof c.label!==\u0027string\u0027||!c.label.trim())throw Error(\u0027控件 ID 或名称无效 / 重复\u0027);ids.add(c.id);\n      if(![\u0027number\u0027,\u0027toggle\u0027,\u0027button\u0027].includes(c.type))throw Error(\u0027控件类型需要 number、toggle 或 button\u0027);\n      if(c.type===\u0027number\u0027\u0026\u0026(!Number.isFinite(c.min)||!Number.isFinite(c.max)||c.min\u003e=c.max||!Number.isFinite(c.value)||c.value\u003cc.min||c.value\u003ec.max))throw Error(\u0027数值控件的范围或默认值无效\u0027);\n      if(c.type===\u0027toggle\u0027\u0026\u0026typeof c.value!==\u0027boolean\u0027)throw Error(\u0027开关默认值必须是布尔值\u0027);\n    }return controls;\n  }\n  function encode(binding,value) {\n    const bytes=hex(binding.base),offset=Number(binding.offset),width=Number(binding.width);\n    if(!Number.isInteger(offset)||offset\u003c0||![1,2,4].includes(width)||offset+width\u003ebytes.length)throw Error(\u0027绑定偏移 / 长度超出报文\u0027);\n    if(![\u0027little\u0027,\u0027big\u0027].includes(binding.endian))throw Error(\u0027字节序无效\u0027);\n    if(!Number.isInteger(value)||value\u003c0||value\u003e=2**(8*width))throw Error(\u0027绑定值必须为该字节宽度内的非负整数\u0027);\n    for(let i=0;i\u003cwidth;i++)bytes[offset+(binding.endian===\u0027little\u0027?i:width-1-i)]=Math.floor(value/2**(8*i))%256;\n    return format(bytes);\n  }\n  function validateProject(p) {\n    if(!/^[a-z0-9][a-z0-9._-]{0,79}$/i.test(p.id)||p.id===\u0027hhub.developer-tools\u0027||p.id.includes(\u0027..\u0027))throw Error(\u0027请填写唯一的插件 ID，例如 community.my-mouse\u0027);\n    if(!p.name?.trim()||!p.author?.trim()||!/^\\d+\\.\\d+\\.\\d+$/.test(p.version))throw Error(\u0027填写插件名称、作者及版本号，例如 0.1.0\u0027);\n    if(!templates.some(t=\u003et.kind===p.kind)||![\u0027usb-hid\u0027,\u0027usb-vendor\u0027,\u0027bluetooth\u0027,\u0027audio-endpoint\u0027].includes(p.transport))throw Error(\u0027外设类型或连接方式无效\u0027);\n    if(p.transport.startsWith(\u0027usb\u0027)\u0026\u0026(!/^[0-9a-f]{4}$/i.test(p.vid)||!/^[0-9a-f]{4}$/i.test(p.pid)))throw Error(\u0027USB 设备需要四位 VID / PID\u0027);\n    validateControls(p.controls);\n    if(!Array.isArray(p.bindings)||p.bindings.length\u003e64)throw Error(\u0027绑定数量无效\u0027);\n    for(const binding of p.bindings) {const control=p.controls.find(c=\u003ec.id===binding.control);if(!control)throw Error(\u0027绑定引用了不存在的控件\u0027);encode(binding,0);}\n    if(p.bindings.length\u0026\u0026!p.protocolConfirmed)throw Error(\u0027导出绑定前请确认已用官方驱动重复验证报文\u0027);return p;\n  }\n  function manifest(project) {\n    const p=validateProject(clone(project));\n    return {schemaVersion:1,id:p.id,name:p.name,author:p.author,version:p.version,apiVersion:\u00271.0\u0027,developmentOnly:true,\n      permissions:p.bindings.length?[\u0027设备读取\u0027,\u0027设备配置\u0027]:[\u0027设备读取\u0027],updateUrl:\u0027\u0027,\n      devices:[{kind:p.kind,transport:p.transport,vid:p.vid,pid:p.pid}],\n      deviceUi:{format:p.customUi?\u0027html\u0027:\u0027controls\u0027,controls:p.controls,content:p.customUi||\u0027\u0027},\n      protocol:{schemaVersion:1,verified:p.protocolConfirmed,bindings:p.bindings},\n      note:\u0027由 H hub 开发者工具导出的开发包。硬件 Worker 和获准设备通道仍需作者实现及真机验证；导入不会发送硬件命令。\u0027};\n  }\n  function project(kind) {const t=templates.find(t=\u003et.kind===kind);if(!t)throw Error(\u0027外设类型无效\u0027);return {schemaVersion:1,kind,id:\u0027\u0027,name:\u0027\u0027,author:\u0027\u0027,version:\u00270.1.0\u0027,transport:kind===\u0027audio\u0027?\u0027audio-endpoint\u0027:\u0027usb-hid\u0027,vid:\u0027\u0027,pid:\u0027\u0027,controls:clone(t.controls),customUi:\u0027\u0027,bindings:[],protocolConfirmed:false};}\n  return {templates,hex,format,parseCapture,compare,validateControls,encode,validateProject,manifest,project};\n})();\n\u003c/script\u003e\u003cscript\u003econst HhubMouse=(()=\u003e{\n const oldProject=HhubDev.project,oldManifest=HhubDev.manifest;\n const defaults=()=\u003e({model:\u0027\u0027,deviceVersion:\u0027\u0027,firmware:\u0027\u0027,identityConfirmed:false,firmwareConfirmed:false,currentConnection:\u0027wired\u0027,developmentMethod:\u0027capture\u0027,sourceRepo:\u0027\u0027,sourceRevision:\u0027\u0027,sourceLicense:\u0027\u0027,sourceAttribution:\u0027\u0027,sourceLicenseText:\u0027\u0027,sourceReviewed:false,platformAdapted:false,sourceReuseKind:\u0027reference\u0027,connections:[{id:\u0027wired\u0027,label:\u0027USB 有线\u0027,transport:\u0027usb-hid\u0027,supported:true,vid:\u0027\u0027,pid:\u0027\u0027},{id:\u0027receiver\u0027,label:\u00272.4 GHz 接收器\u0027,transport:\u0027usb-hid\u0027,supported:false,vid:\u0027\u0027,pid:\u0027\u0027},{id:\u0027bluetooth\u0027,label:\u0027蓝牙\u0027,transport:\u0027bluetooth\u0027,supported:false,vid:\u0027\u0027,pid:\u0027\u0027}]});\n HhubDev.project=kind=\u003eObject.assign(oldProject(kind),kind===\u0027mouse\u0027?defaults():{});\n function normalize(p){if(p.kind!==\u0027mouse\u0027)return p;const d=defaults();for(const key of Object.keys(d))if(p[key]===undefined)p[key]=d[key];return p;}\n function validate(p){normalize(p);if(!p.model.trim()||!p.deviceVersion.trim()||!p.identityConfirmed)throw Error(\u0027先核对鼠标型号、硬件版本与连接方式\u0027);if(!p.firmware.trim()||!p.firmwareConfirmed)throw Error(\u0027先核对当前鼠标固件号，不能用驱动版本代替\u0027);\n  if(!Array.isArray(p.connections)||!p.connections.some(c=\u003ec.supported\u0026\u0026c.id===p.currentConnection))throw Error(\u0027选择已核对的当前连接方式\u0027);\n  const ids=new Set();for(const c of p.connections){if(ids.has(c.id)||![\u0027wired\u0027,\u0027receiver\u0027,\u0027bluetooth\u0027].includes(c.id))throw Error(\u0027连接配置无效\u0027);ids.add(c.id);if(c.supported\u0026\u0026(!/^[0-9a-f]{4}$/i.test(c.vid)||!/^[0-9a-f]{4}$/i.test(c.pid)))throw Error(\u0027分别核对每种启用连接方式的 VID / PID，不能沿用另一种连接的值\u0027);}\n  for(const b of p.bindings){if(!p.connections.some(c=\u003ec.supported\u0026\u0026c.id===b.connectionId))throw Error(\u0027每个绑定必须关联一个已核对连接\u0027);if(b.firmware!==p.firmware||b.deviceVersion!==p.deviceVersion)throw Error(\u0027固件或硬件版本已变化，请重新核对旧绑定\u0027);}\n  if(![\u0027capture\u0027,\u0027opensource\u0027].includes(p.developmentMethod))throw Error(\u0027开发路线无效\u0027);\n  if(p.developmentMethod===\u0027opensource\u0027){if([\u0027main\u0027,\u0027master\u0027,\u0027head\u0027,\u0027latest\u0027].includes(p.sourceRevision.trim().toLowerCase()))throw Error(\u0027请使用固定提交 SHA 或发布版本，不要使用会移动的分支名\u0027);if(!/^https:\\/\\//.test(p.sourceRepo)||!p.sourceRevision.trim()||!p.sourceLicense.trim()||!p.sourceAttribution.trim()||!p.sourceReviewed||!p.platformAdapted)throw Error(\u0027开源路线需要来源、固定版本、许可证、署名及型号/Windows 适配确认\u0027);if(p.sourceReuseKind===\u0027adapted-code\u0027\u0026\u0026!p.sourceLicenseText.trim())throw Error(\u0027借用代码时必须附带上游完整许可声明\u0027);}\n  return p;\n }\n function module(p){HhubDev.validateProject(p);if(p.kind===\u0027mouse\u0027)validate(p);return {format:\u0027hhub-ir/1\u0027,host:\u0027hhub\u0027,apiVersion:\u00271.0\u0027,programs:p.bindings.map(b=\u003e({op:\u0027patch-uint\u0027,...b,offset:Number(b.offset),width:Number(b.width),base:HhubDev.format(HhubDev.hex(b.base)),firmware:p.firmware||\u0027\u0027,deviceVersion:p.deviceVersion||\u0027\u0027}))};}\n function source(p){const m=module(p);let text=\u0027// Generated for the H hub plugin host; library module, no standalone Main.\\nusing System;\\nnamespace Hhub.Generated {\\n public interface IHhubCommandContext { string HostId {get;} string ApiVersion {get;} bool IsGranted(string pluginId,string connectionId); }\\n public sealed class PluginModule {\\n  public byte[] Encode(IHhubCommandContext host,string control,string connection,uint value) {\\n   if(host==null||host.HostId!=\"hhub\"||host.ApiVersion!=\"1.0\"||!host.IsGranted(\u0027+JSON.stringify(p.id)+\u0027,connection))throw new UnauthorizedAccessException(\"H hub host session required\");\\n\u0027;\n  if(p.kind===\u0027mouse\u0027\u0026\u0026p.developmentMethod===\u0027opensource\u0027){const oneLine=v=\u003eString(v).replace(/[\\r\\n]/g,\u0027 \u0027);text=\u0027// Upstream reference: \u0027+oneLine(p.sourceRepo)+\u0027 @ \u0027+oneLine(p.sourceRevision)+\u0027\\n// Upstream author: \u0027+oneLine(p.sourceAttribution)+\u0027\\n// Upstream licence: \u0027+oneLine(p.sourceLicense)+\u0027; reuse: \u0027+oneLine(p.sourceReuseKind)+\u0027\\n\u0027+(p.sourceReuseKind===\u0027adapted-code\u0027?p.sourceLicenseText.split(/\\r?\\n/).map(line=\u003e\u0027// \u0027+line).join(\u0027\\n\u0027)+\u0027\\n\u0027:\u0027\u0027)+text;}\n  for(const b of m.programs){const bytes=HhubDev.hex(b.base);text+=\u0027   if(control==\u0027+JSON.stringify(b.control)+\u0027\u0026\u0026connection==\u0027+JSON.stringify(b.connectionId||\u0027default\u0027)+\u0027) {\\n    if((ulong)value \u003e= \u0027+(2**(b.width*8))+\u0027UL)throw new ArgumentOutOfRangeException(\"value\");\\n    var bytes=new byte[]{\u0027+bytes.join(\u0027,\u0027)+\u0027};\\n\u0027;for(let i=0;i\u003cb.width;i++)text+=\u0027    bytes[\u0027+(Number(b.offset)+(b.endian===\u0027little\u0027?i:b.width-1-i))+\u0027]=(byte)(value \u003e\u003e \u0027+(i*8)+\u0027);\\n\u0027;text+=\u0027    return bytes;\\n   }\\n\u0027;}\n  return text+\u0027   throw new ArgumentException(\"Unknown control or connection\");\\n  }\\n }\\n}\\n\u0027;\n }\n HhubDev.manifest=p=\u003e{if(p.kind===\u0027mouse\u0027)validate(p);const result=oldManifest(p);result.requiredHost={id:\u0027hhub\u0027,apiVersion:\u00271.0\u0027,execution:\u0027host-only\u0027,standalone:false};result.module=module(p);result.generatedSource={language:\u0027csharp\u0027,target:\u0027library\u0027,content:source(p)};if(p.kind===\u0027mouse\u0027){result.mouse={model:p.model,deviceVersion:p.deviceVersion,firmware:p.firmware,connections:p.connections.filter(c=\u003ec.supported),developmentMethod:p.developmentMethod};result.devices=p.connections.filter(c=\u003ec.supported).map(c=\u003e({kind:\u0027mouse\u0027,connectionId:c.id,transport:c.transport,vid:c.vid,pid:c.pid,deviceVersion:p.deviceVersion,firmware:p.firmware}));if(p.developmentMethod===\u0027opensource\u0027)result.sources=[{repository:p.sourceRepo,revision:p.sourceRevision,license:p.sourceLicense,attribution:p.sourceAttribution,licenseText:p.sourceLicenseText,reuse:p.sourceReuseKind,windowsAdaptationReviewed:p.platformAdapted}];}if(new TextEncoder().encode(JSON.stringify(result,null,2)).length\u003e262144)throw Error(\u0027插件包超过主程序 256 KB 导入上限，请拆分功能或缩减页面资源\u0027);return result;};\n function analyze(text){if(text.length\u003e2*1024*1024)throw Error(\u0027源码文件不能超过 2 MB\u0027);const matches=[...text.matchAll(/(?:usb|bluetooth):([0-9a-f]{4}):([0-9a-f]{4})/gi)].map(m=\u003e({vid:m[1],pid:m[2]}));const symbols=[...text.matchAll(/(?:def\\s+|\\b(?:int|void|bool|uint\\w*|byte)\\s+)([a-z_][a-z0-9_]*)\\s*\\(/gi)].map(m=\u003em[1]).slice(0,80);const constants=[...new Set(text.match(/0x[0-9a-f]{2,8}\\b/gi)||[])].slice(0,80);return {deviceMatches:matches,symbols,constants,note:\u0027仅建立源码候选索引；需人工理解请求、回读、型号差异与平台接口，不能自动认定这些常量是目标鼠标指令。\u0027};}\n function hidppDpi(device,feature,software,sensor,dpi){for(const n of [device,feature,sensor])if(!Number.isInteger(n)||n\u003c0||n\u003e255)throw Error(\u0027设备 / 功能 / 传感器索引需要 0–255\u0027);if(!feature||!Number.isInteger(software)||software\u003c1||software\u003e15||!Number.isInteger(dpi)||dpi\u003c1||dpi\u003e65535)throw Error(\u0027请核对功能索引、软件 ID 与 DPI\u0027);const bytes=Array(20).fill(0);bytes[0]=0x11;bytes[1]=device;bytes[2]=feature;bytes[3]=0x30|software;bytes[4]=sensor;bytes[5]=dpi\u003e\u003e8;bytes[6]=dpi\u0026255;return HhubDev.format(bytes);}\n return {normalize,validate,module,source,analyze,hidppDpi};\n})();\n\u003c/script\u003e\u003cscript\u003eHhubMouse.mount=function(detail,getProject,read,status,preview){\n if(getProject().kind!==\u0027mouse\u0027)return;HhubMouse.normalize(getProject());const body=detail.querySelector(\u0027.environment\u0027);body.querySelector(\u0027.steps\u0027).innerHTML=[\u00271 连接与硬件版本\u0027,\u00272 各连接 VID/PID\u0027,\u00273 当前固件\u0027,\u00274 功能与 UI\u0027,\u00275 抓包 / 开源分析与测试\u0027,\u00276 代码、打包、安装测试\u0027].map(s=\u003e\u0027\u003cspan\u003e\u0027+s+\u0027\u003c/span\u003e\u0027).join(\u0027\u0027);\n const extra=document.createElement(\u0027section\u0027);extra.innerHTML=`\u003ch2\u003e1 确认连接方式与鼠标版本\u003c/h2\u003e\u003cdiv class=\"fields\"\u003e\u003clabel\u003e鼠标型号\u003cinput data-field=\"model\" placeholder=\"例如 VT3S MAX\"\u003e\u003c/label\u003e\u003clabel\u003e鼠标硬件版本 / 代次\u003cinput data-field=\"deviceVersion\" placeholder=\"按型号标签或官方软件核对\"\u003e\u003c/label\u003e\u003clabel\u003e当前连接\u003cselect data-field=\"currentConnection\"\u003e\u003coption value=\"wired\"\u003eUSB 有线\u003c/option\u003e\u003coption value=\"receiver\"\u003e2.4 GHz 接收器\u003c/option\u003e\u003coption value=\"bluetooth\"\u003e蓝牙\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003clabel\u003e开发路线\u003cselect data-field=\"developmentMethod\"\u003e\u003coption value=\"capture\"\u003e路线一：官方驱动抓包\u003c/option\u003e\u003coption value=\"opensource\"\u003e路线二：分析与复用开源项目\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003c/div\u003e\u003clabel class=\"check\"\u003e\u003cinput type=\"checkbox\" data-field=\"identityConfirmed\"\u003e已核对鼠标型号、硬件版本与连接方式\u003c/label\u003e\n \u003ch2\u003e2 分别确认各连接方式的 VID / PID\u003c/h2\u003e\u003cp\u003e只启用实际支持的连接。每一种连接分别枚举并核对，不复制接收器或另一连接方式的标识。蓝牙标识无法确认时，先保持未启用。\u003c/p\u003e\u003cdiv data-connections\u003e\u003c/div\u003e\n \u003ch2\u003e3 确认当前鼠标固件号\u003c/h2\u003e\u003clabel\u003e鼠标固件号\u003cinput data-field=\"firmware\" placeholder=\"从官方驱动或已验证的设备查询接口取得\"\u003e\u003c/label\u003e\u003clabel class=\"check\"\u003e\u003cinput type=\"checkbox\" data-field=\"firmwareConfirmed\"\u003e已核对当前鼠标固件，填写的不是驱动或插件版本\u003c/label\u003e`;\n const firstHeading=body.querySelector(\u0027h2\u0027);firstHeading.textContent=\u0027插件身份\u0027;body.insertBefore(extra,firstHeading);\n for(const c of getProject().connections){const row=document.createElement(\u0027div\u0027);row.className=\u0027fields\u0027;row.dataset.connection=c.id;row.innerHTML=\u0027\u003clabel class=\"check\"\u003e\u003cinput type=\"checkbox\" data-key=\"supported\"\u003e\u0027+c.label+\u0027\u003c/label\u003e\u003cdiv class=\"fields\"\u003e\u003clabel\u003eVID\u003cinput data-key=\"vid\" maxlength=\"4\"\u003e\u003c/label\u003e\u003clabel\u003ePID\u003cinput data-key=\"pid\" maxlength=\"4\"\u003e\u003c/label\u003e\u003c/div\u003e\u0027;extra.querySelector(\u0027[data-connections]\u0027).append(row);}\n const sourcePanel=document.createElement(\u0027section\u0027);sourcePanel.dataset.sourcePanel=\u0027\u0027;sourcePanel.innerHTML=`\u003ch2\u003e5 路线二：开源项目分析\u003c/h2\u003e\u003cp\u003e第一研究对象：ClickSync（GPL-2.0，多品牌 WebHID，含雷柏协议）。其他候选有 libratbag 和 logiflick（MIT）。不能把 Logitech 的协议直接套到雷柏等其他鼠标上；支持情况应以具体型号、固件和连接核对。\u003c/p\u003e\u003cbutton data-mouse-action=\"clicksync\"\u003e采用 ClickSync 研究记录\u003c/button\u003e\u003cdiv class=\"fields\"\u003e\u003clabel\u003e源码仓库 HTTPS 地址\u003cinput data-field=\"sourceRepo\"\u003e\u003c/label\u003e\u003clabel\u003e固定提交 / 版本\u003cinput data-field=\"sourceRevision\"\u003e\u003c/label\u003e\u003clabel\u003e许可证标识\u003cinput data-field=\"sourceLicense\" placeholder=\"例如 MIT 或 GPL-3.0-only\"\u003e\u003c/label\u003e\u003clabel\u003e原作者与来源署名\u003cinput data-field=\"sourceAttribution\"\u003e\u003c/label\u003e\u003clabel\u003e复用方式\u003cselect data-field=\"sourceReuseKind\"\u003e\u003coption value=\"reference\"\u003e协议研究参考\u003c/option\u003e\u003coption value=\"adapted-code\"\u003e借用 / 改编上游代码\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003clabel\u003e导入源码 / .device 文件\u003cinput type=\"file\" data-source-file accept=\".c,.h,.py,.cs,.device,.txt\"\u003e\u003c/label\u003e\u003c/div\u003e\u003clabel\u003e上游完整许可声明（借用代码时必填）\u003ctextarea data-field=\"sourceLicenseText\"\u003e\u003c/textarea\u003e\u003c/label\u003e\u003clabel class=\"check\"\u003e\u003cinput type=\"checkbox\" data-field=\"sourceReviewed\"\u003e已分析设备匹配、相关方法与请求 / 回读，并核对复用许可\u003c/label\u003e\u003clabel class=\"check\"\u003e\u003cinput type=\"checkbox\" data-field=\"platformAdapted\"\u003e已核对 Windows 适配，未直接依赖 Linux 的 DBus / hidraw 接口\u003c/label\u003e\u003cpre data-source-result\u003e等待源码文件；候选索引不能替代人工协议分析\u003c/pre\u003e\n \u003ch2\u003e已研究的 HID++ DPI 报文模板\u003c/h2\u003e\u003cp\u003e仅适用于已验证的 Logitech HID++ 2.0、0x2201 DPI 功能；功能索引与设备索引需要实际查询。模板不发现设备、不发送命令，也不是完整 HID++ 驱动。\u003c/p\u003e\u003cdiv class=\"fields\"\u003e\u003clabel\u003e设备索引\u003cinput type=\"number\" data-hidpp=\"device\" min=\"0\" max=\"255\"\u003e\u003c/label\u003e\u003clabel\u003e已查询的 DPI 功能索引\u003cinput type=\"number\" data-hidpp=\"feature\" min=\"1\" max=\"255\"\u003e\u003c/label\u003e\u003clabel\u003e软件 ID（1–15）\u003cinput type=\"number\" data-hidpp=\"software\" min=\"1\" max=\"15\"\u003e\u003c/label\u003e\u003clabel\u003e传感器索引\u003cinput type=\"number\" data-hidpp=\"sensor\" min=\"0\" max=\"255\"\u003e\u003c/label\u003e\u003clabel\u003eDPI\u003cinput type=\"number\" data-hidpp=\"dpi\" min=\"1\" max=\"65535\"\u003e\u003c/label\u003e\u003c/div\u003e\u003cbutton data-mouse-action=\"hidpp\"\u003e生成 HID++ 候选基础报文\u003c/button\u003e`;\n const captureHeading=[...body.querySelectorAll(\u0027h2\u0027)].find(h=\u003eh.textContent===\u0027官方驱动与抓包对照\u0027);captureHeading.textContent=\u00275 功能抓包与测试\u0027;body.insertBefore(sourcePanel,captureHeading);\n const uiHeading=[...body.querySelectorAll(\u0027h2\u0027)].find(h=\u003eh.textContent===\u0027页面模板与自定义 UI\u0027);uiHeading.textContent=\u00274 定义鼠标功能与 UI\u0027;const finalHeading=[...body.querySelectorAll(\u0027h2\u0027)].find(h=\u003eh.textContent===\u0027验证与导出\u0027);finalHeading.textContent=\u00276 生成代码、打包与安装测试\u0027;\n const actions=document.createElement(\u0027div\u0027);actions.className=\u0027actions\u0027;actions.innerHTML=\u0027\u003cbutton data-mouse-action=\"module\"\u003e生成 H hub 模块代码\u003c/button\u003e\u003cbutton data-mouse-action=\"source\"\u003e下载 C# 模块源码\u003c/button\u003e\u0027;body.insertBefore(actions,finalHeading.nextSibling);const installGuide=document.createElement(\u0027p\u0027);installGuide.textContent=\u0027导出 .hhub 后，到主程序插件管理安装，运行“模块编码测试”核对生成报文。真实设备发送、回读与断线恢复仍需硬件运行通道和真机验收。生成包声明 H hub 专用宿主契约，没有独立 EXE 启动入口；该契约不限制上游开源代码本身的合法移植。\u0027;body.append(installGuide);\n function sync(){const p=getProject();HhubMouse.normalize(p);for(const row of detail.querySelectorAll(\u0027[data-connection]\u0027)){const c=p.connections.find(c=\u003ec.id===row.dataset.connection);for(const input of row.querySelectorAll(\u0027[data-key]\u0027))c[input.dataset.key]=input.type===\u0027checkbox\u0027?input.checked:input.value.trim();}const c=p.connections.find(c=\u003ec.id===p.currentConnection);if(c){p.vid=c.vid;p.pid=c.pid;p.transport=c.transport;for(const key of [\u0027vid\u0027,\u0027pid\u0027,\u0027transport\u0027])detail.querySelector(\u0027[data-field=\u0027+key+\u0027]\u0027).value=p[key];}sourcePanel.hidden=p.developmentMethod!==\u0027opensource\u0027;const check=detail.querySelector(\u0027[data-field=protocolConfirmed]\u0027).parentElement;check.lastChild.textContent=p.developmentMethod===\u0027opensource\u0027?\u0027已结合开源实现及目标鼠标型号 / 固件回读重复核对协议\u0027:\u0027已通过多组官方驱动抓包重复核对绑定，并记录型号 / 固件与通道\u0027;}\n detail.mouseSync=sync;detail.mouseFill=()=\u003e{const p=getProject();HhubMouse.normalize(p);for(const row of detail.querySelectorAll(\u0027[data-connection]\u0027)){const c=p.connections.find(c=\u003ec.id===row.dataset.connection);for(const input of row.querySelectorAll(\u0027[data-key]\u0027)){if(input.type===\u0027checkbox\u0027)input.checked=c.supported;else input.value=c[input.dataset.key]||\u0027\u0027;}}sourcePanel.hidden=p.developmentMethod!==\u0027opensource\u0027;};\n for(const key of [\u0027vid\u0027,\u0027pid\u0027,\u0027transport\u0027])detail.querySelector(\u0027[data-field=\u0027+key+\u0027]\u0027).disabled=true;\n for(const input of detail.querySelectorAll(\u0027[data-key]\u0027))input.addEventListener(\u0027change\u0027,()=\u003e{read();sync();});\n detail.querySelector(\u0027[data-source-file]\u0027).addEventListener(\u0027change\u0027,async e=\u003e{try{const file=e.target.files[0];if(!file)return;if(file.size\u003e2*1024*1024)throw Error(\u0027源码不能超过 2 MB\u0027);detail.querySelector(\u0027[data-source-result]\u0027).textContent=JSON.stringify(HhubMouse.analyze(await file.text()),null,2);status(\u0027已建立源码候选索引，请结合固定版本人工核对\u0027);}catch(error){status(error.message,true)}});\n for(const button of detail.querySelectorAll(\u0027[data-mouse-action]\u0027))button.addEventListener(\u0027click\u0027,()=\u003e{try{const p=read();sync();const action=button.dataset.mouseAction;if(action===\u0027clicksync\u0027){Object.assign(p,{sourceRepo:\u0027https://github.com/Nuitfanee/ClickSync\u0027,sourceLicense:\u0027GPL-2.0\u0027,sourceAttribution:\u0027Nuitfanee / ClickSync\u0027,sourceRevision:\u0027\u0027,sourceLicenseText:\u0027\u0027,sourceReviewed:false,platformAdapted:false});for(const key of [\u0027sourceRepo\u0027,\u0027sourceLicense\u0027,\u0027sourceAttribution\u0027,\u0027sourceRevision\u0027,\u0027sourceLicenseText\u0027])detail.querySelector(\u0027[data-field=\u0027+key+\u0027]\u0027).value=p[key];detail.querySelector(\u0027[data-field=sourceReviewed]\u0027).checked=false;detail.querySelector(\u0027[data-field=platformAdapted]\u0027).checked=false;detail.querySelector(\u0027[data-source-result]\u0027).textContent=\u0027研究结论：WebHID 多品牌协议；雷柏候选需要 VID 24AE、UsagePage FF00、Usage 14/15。是否匹配应在当前电脑重新枚举，并核对硬件版本与固件。源码许可 GPL-2.0；改编需保留许可、来源及对应源码，不能把仅兼容 H hub 的包格式当作限制上游代码移植的许可。请填写固定源码版本后进行适配与验证。\u0027;}\n else if(action===\u0027module\u0027)download((p.id||\u0027mouse\u0027)+\u0027.hhub-code.json\u0027,HhubMouse.module(p));else if(action===\u0027source\u0027){const code=HhubMouse.source(p);const href=URL.createObjectURL(new Blob([code],{type:\u0027text/plain\u0027}));const a=document.createElement(\u0027a\u0027);a.href=href;a.download=p.id+\u0027.cs\u0027;a.click();setTimeout(()=\u003eURL.revokeObjectURL(href),30000);}else{if(p.vid.toLowerCase()!==\u0027046d\u0027)throw Error(\u0027这个模板仅用于已核对的 Logitech VID 046D，不能套用到当前品牌\u0027);const values=[\u0027device\u0027,\u0027feature\u0027,\u0027software\u0027,\u0027sensor\u0027,\u0027dpi\u0027].map(k=\u003e{const value=detail.querySelector(\u0027[data-hidpp=\u0027+k+\u0027]\u0027).value;if(!value.trim())throw Error(\u0027请先查询并填写全部 HID++ 参数\u0027);return Number(value)});detail.querySelector(\u0027[data-binding=base]\u0027).value=HhubMouse.hidppDpi(...values);detail.querySelector(\u0027[data-binding=offset]\u0027).value=\u00275\u0027;detail.querySelector(\u0027[data-binding=width]\u0027).value=\u00272\u0027;detail.querySelector(\u0027[data-binding=endian]\u0027).value=\u0027big\u0027;}status(\u0027已生成候选代码 / 报文；未发送硬件命令\u0027);}catch(error){status(error.message,true)}});\n};\n\u003c/script\u003e\u003cscript\u003edocument.documentElement.dataset.theme=window.hhubTheme||\u0027dark\u0027;\nwindow.hhubRapooTemplate=\"\\u003c!doctype html\\u003e\\u003chtml lang=\\\"zh-CN\\\"\\u003e\\u003chead\\u003e\\u003cmeta charset=\\\"UTF-8\\\"\\u003e\\u003cmeta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"\\u003e\\u003ctitle\\u003eVT3S MAX · H hub\\u003c/title\\u003e\\u003cstyle\\u003e:root{color-scheme:dark;font-family:\\u0027Segoe UI\\u0027,\\u0027Microsoft YaHei\\u0027,sans-serif;color:#e5edf6;background:#141a22;--accent:#72baff;--line:#2d3744;--muted:#94a3b5}*{box-sizing:border-box}body{margin:0}main{max-width:1200px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center;gap:20px;border-bottom:1px solid var(--line);padding-bottom:18px}h1{font-size:27px;margin:8px 0}h1 span,.eyebrow{font-size:11px;letter-spacing:1.4px;color:var(--muted)}h1 span{background:#19332e;color:#90d4b8;padding:5px 9px;border-radius:5px;vertical-align:middle}p{color:var(--muted);font-size:12px;line-height:1.7;margin:8px 0}.toolbar,.row,.chips{display:flex;gap:8px;flex-wrap:wrap;align-items:center}button,input,select,textarea{font:inherit}button{border:1px solid var(--line);background:#202936;color:#cdd9e7;border-radius:7px;padding:9px 13px;cursor:pointer}button:hover{border-color:#60778d;background:#293646}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:#72baff;color:#101c2a;border-color:#72baff;font-weight:600}button.active{background:#203d58;color:#a8d4ff;border-color:#588ebd}button:disabled{opacity:.4;cursor:default}.notice{display:flex;gap:9px;align-items:center;font-size:11px;padding:12px 0;color:var(--muted);margin:3px 0 12px}.dot{width:6px;height:6px;background:#e3b66c;border-radius:50%}output#status{margin-left:auto;color:#a5c7dd}nav{display:flex;gap:4px;margin-bottom:22px;border-bottom:1px solid var(--line);flex-wrap:wrap}nav button{background:transparent;border:0;border-radius:0;padding:12px 18px;color:var(--muted);border-bottom:2px solid transparent}nav button.active{background:transparent;color:#dcefff;border-color:var(--accent)}section{min-height:420px}.grid{display:grid;grid-template-columns:minmax(240px,.85fr) minmax(0,1.7fr);gap:14px;align-items:start}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{background:#1b232e;border:1px solid var(--line);border-radius:10px;padding:20px;margin-bottom:14px}.grid .card{margin-bottom:0}h2{font-size:15px;font-weight:600;margin:0 0 16px}h3{font-size:13px;font-weight:500;margin:0 0 6px}.hint{font-size:11px;color:var(--muted)}.large{font-size:44px;font-weight:500;letter-spacing:-1.5px;color:#e4f1ff;font-variant-numeric:tabular-nums;margin:14px 0 18px}.large small{font-size:13px;letter-spacing:1px;color:var(--muted);margin-left:8px}input[type=range]{width:100%;accent-color:var(--accent);margin:16px 0 8px}input[type=number],input[type=text],select,textarea{border:1px solid var(--line);background:#141b24;color:#e5edf6;padding:9px 11px;border-radius:6px;width:100%}label{font-size:12px;color:var(--muted);display:block;margin:12px 0}label input[type=checkbox]{accent-color:var(--accent);margin-right:8px}.field{max-width:150px}.split{display:flex;align-items:center;justify-content:space-between;gap:14px}.switch{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);margin:0}.switch:last-child{border-bottom:0}.switch input{appearance:none;flex-shrink:0;width:34px;height:19px;border-radius:20px;background:#425064;border:0;position:relative;cursor:pointer;margin:0}.switch input:before{content:\\u0027\\u0027;position:absolute;width:13px;height:13px;left:3px;top:3px;background:#d4dce7;border-radius:50%;transition:transform .15s}.switch input:checked{background:#559ddb}.switch input:checked:before{transform:translateX(15px);background:#fff}.mouse-art{height:240px;width:100%;filter:drop-shadow(0 14px 12px #0005)}.mouse-panel{text-align:center;background:radial-gradient(ellipse at 50% 35%,#2a394a 0%,#1b232e 70%)}.hotspots{justify-content:center}.chips button{font-size:12px}.stage{display:flex;align-items:center;border:1px solid var(--line);border-radius:7px;overflow:hidden}.stage button{border:0;border-radius:0;min-width:66px}.stage .remove{padding:9px 7px;font-size:12px;min-width:24px;border-left:1px solid var(--line);color:var(--muted)}.dial{width:130px;height:130px;margin:16px auto;border:9px solid #2c3e51;border-top-color:#72baff;border-radius:50%;display:grid;place-items:center;background:#151e29}.dial span{font-size:30px;color:#c6e3ff}textarea{min-height:100px;resize:vertical}.wide{grid-column:1/-1}.value{font-weight:600;color:#c6e3ff}footer{font-size:10px;color:#8191a5;margin-top:18px;line-height:1.7}.color-black{background:#26292d!important;color:#fff}.color-white{background:#e2e6ec!important;color:#18222e}.color-yellow{background:#d3de47!important;color:#1a240c}.color-pink{background:#d43970!important;color:#fff}@media(max-width:760px){main{padding:16px}header{align-items:flex-start;flex-direction:column;gap:8px}.grid,.cards{grid-template-columns:1fr}.card{padding:16px}.notice{flex-wrap:wrap}output#status{margin-left:0}nav button{padding:10px 12px}h1{font-size:24px}.mouse-art{height:170px}.toolbar button{font-size:12px;padding:8px 10px}.split{flex-wrap:wrap}}\\nheader\\u003ediv:first-child{flex-shrink:0;min-width:215px}header .toolbar{flex:1;min-width:0;justify-content:flex-end}h1 span{white-space:nowrap}@media(max-width:760px){header .toolbar{justify-content:flex-start}}\\nmain{max-width:1200px;padding:12px 16px}header{padding-bottom:6px;gap:12px;flex-direction:row!important}h1{font-size:20px;margin:0}header .hint{font-size:11px}.notice{padding:6px 0;margin:0 0 5px;flex-wrap:wrap}nav{margin-bottom:10px}nav button{padding:8px 16px}section{min-height:0}.card{padding:14px;margin-bottom:10px}.grid,.cards{gap:10px}h2{margin-bottom:10px;font-size:14px}h3{margin-bottom:4px}.large{font-size:34px;margin:8px 0}.switch{padding:9px 0}.hint,p{font-size:11px;line-height:1.45}.chips{gap:6px}.chips button{padding:7px 10px}.mouse-art{height:155px}.dial{width:90px;height:90px;margin:10px auto;border-width:7px}.dial span{font-size:24px}.range-control{display:grid;grid-template-columns:minmax(0,1fr) 92px;gap:6px 12px;align-items:center;margin:10px 0}.range-control label{grid-column:1/-1;margin:0}.range-control input[type=range]{margin:0}.range-control input[type=number]{padding:6px 8px}.dpi-grid{grid-template-columns:minmax(0,1.5fr) minmax(240px,1fr)}.dpi-grid .wide{grid-column:auto}.stage button{min-width:54px}.settings-grid{grid-template-columns:1fr 1fr}.notice #device-battery{margin-left:8px}textarea{min-height:72px;height:100px}.settings-grid .split{gap:8px}.settings-grid .chips{margin-top:10px}@media(max-width:760px){main{padding:10px}.grid,.cards{grid-template-columns:1fr 1fr}.dpi-grid{grid-template-columns:1fr 1fr}.card{padding:10px}nav button{padding:8px 10px}.mouse-art{height:120px}.hint{font-size:10px}.range-control{grid-template-columns:minmax(0,1fr) 70px}.stage button{min-width:44px}button{font-size:12px;padding:7px 10px}}@media(max-width:520px){.grid,.cards,.dpi-grid{grid-template-columns:1fr}.notice{font-size:10px}header h1{font-size:17px}}\\n#page\\u003e.cards{grid-template-columns:repeat(2,minmax(0,1fr))}\\n\\n/* One stable frame across all device tabs. */\\nmain{height:100dvh;display:flex;flex-direction:column;gap:0}header,.notice,nav{flex-shrink:0}#page{flex:1;min-height:0;width:100%;border:1px solid var(--line);border-radius:10px;background:#18212c;padding:12px;overflow:auto}#page\\u003e.grid{height:100%;grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch}#page .card{margin:0;min-width:0;min-height:0;background:#1e2936}#page[data-tab=\\\"0\\\"]\\u003e.grid,#page[data-tab=\\\"1\\\"]\\u003e.grid{grid-template-rows:minmax(0,1fr)}#page[data-tab=\\\"3\\\"]\\u003e.grid{grid-template-rows:repeat(2,minmax(0,1fr))}#page[data-tab=\\\"4\\\"]\\u003e.grid{grid-template-rows:minmax(0,1fr) 60px}#page[data-tab=\\\"0\\\"] .card{display:flex;flex-direction:column}#page[data-tab=\\\"0\\\"] .card\\u003eh2,#page[data-tab=\\\"0\\\"] .card\\u003e.split{margin-bottom:16px}#page[data-tab=\\\"0\\\"] .card\\u003e.chips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;align-content:center;flex:1}#page[data-tab=\\\"0\\\"] .stage{width:100%}#page[data-tab=\\\"0\\\"] .stage\\u003ebutton:first-child{flex:1;padding:12px 8px}#page[data-tab=\\\"0\\\"] .card\\u003ep:last-child{margin-top:auto}#page[data-tab=\\\"2\\\"]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:repeat(4,minmax(0,1fr));gap:10px}#page[data-tab=\\\"2\\\"]\\u003e.cards{grid-column:1/-1;min-height:0;height:100%}#page[data-tab=\\\"2\\\"]\\u003e.card{grid-column:1/-1;display:flex;flex-direction:column;justify-content:center}#page[data-tab=\\\"2\\\"] .cards\\u003e.card{display:flex;flex-direction:column;justify-content:center}#page[data-tab=\\\"3\\\"] .card{display:flex;flex-direction:column;justify-content:center}#page[data-tab=\\\"3\\\"] .switch{flex:1}#page[data-tab=\\\"1\\\"] .mouse-panel{display:flex;flex-direction:column;justify-content:center;gap:16px}#page[data-tab=\\\"1\\\"] .mouse-art{height:180px}#page[data-tab=\\\"4\\\"] .card:first-child,#page[data-tab=\\\"4\\\"] .card:nth-child(2){display:flex;flex-direction:column;justify-content:center;gap:8px}@media(max-width:700px){#page{padding:8px}#page\\u003e.grid{height:auto;min-height:100%;grid-template-columns:1fr;grid-template-rows:auto!important}#page[data-tab=\\\"2\\\"]{display:block}#page[data-tab=\\\"2\\\"]\\u003e.card,#page[data-tab=\\\"2\\\"]\\u003e.cards{margin-bottom:8px}#page[data-tab=\\\"2\\\"] .cards{grid-template-columns:1fr}#page .card{min-height:120px}#page[data-tab=\\\"4\\\"] .card:last-child{min-height:60px}}\\n\\n.notice{height:28px;min-height:28px;flex-wrap:nowrap;overflow:hidden}.notice #status{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.notice #device-battery{white-space:nowrap;flex-shrink:0}\\n\\u003c/style\\u003e\\u003c/head\\u003e\\u003cbody\\u003e\\n\\u003cmain\\u003e\\u003cheader\\u003e\\u003ch1\\u003eVT3S MAX \\u003cspan\\u003e2.4 GHz\\u003c/span\\u003e\\u003c/h1\\u003e\\u003cspan class=\\\"hint\\\"\\u003e自动同步鼠标设置\\u003c/span\\u003e\\u003c/header\\u003e\\n\\u003cdiv class=\\\"notice\\\"\\u003e\\u003cspan class=\\\"dot\\\"\\u003e\\u003c/span\\u003e\\u003cspan\\u003e正在连接鼠标\\u003c/span\\u003e\\u003coutput id=\\\"status\\\" aria-live=\\\"polite\\\"\\u003e就绪\\u003c/output\\u003e\\u003c/div\\u003e\\n\\u003cnav aria-label=\\\"鼠标设置页面\\\" id=\\\"tabs\\\"\\u003e\\u003c/nav\\u003e\\u003csection id=\\\"page\\\"\\u003e\\u003c/section\\u003e\\n\\u003c/main\\u003e\\u003cscript\\u003e(()=\\u003e{if(parent!==window||!window.chrome?.webview)return;let token=0,queue=Promise.resolve();const pending=new Map();window.hhubDeviceTransaction=request=\\u003e{const run=()=\\u003enew Promise((resolve,reject)=\\u003e{const id=\\u0027device-\\u0027+(++token),timer=setTimeout(()=\\u003e{pending.delete(id);reject(Error(\\u0027设备通信超时，请重新读取\\u0027));},12000);pending.set(id,{resolve,reject,timer});window.chrome.webview.postMessage({type:\\u0027hhub.hid\\u0027,token:id,body:{request}});});const result=queue.then(run,run);queue=result.catch(()=\\u003e{});return result;};window.chrome.webview.addEventListener(\\u0027message\\u0027,event=\\u003e{const m=event.data;if(m.type!==\\u0027hhub.hid.result\\u0027)return;const entry=pending.get(m.token);if(!entry)return;clearTimeout(entry.timer);pending.delete(m.token);if(m.error)entry.reject(Error(m.error));else entry.resolve(m.result);});})();\\n\\u003c/script\\u003e\\u003cscript\\u003e// H hub interoperability implementation. Constants researched from ClickSync and Rapoo Hub;\\n// upstream implementations are not embedded. All device mutations require verified readback.\\nconst RapooProtocol=(()=\\u003e{\\n const match={vid:0x24ae,pid:0x1421,usagePage:0xff00,outputUsage:14,featureUsage:15};\\n const hex=b=\\u003eb.map(n=\\u003en.toString(16).padStart(2,\\u00270\\u0027)).join(\\u0027 \\u0027),unhex=s=\\u003es.trim().split(/\\\\s+/).map(n=\\u003eparseInt(n,16));\\n const polls=[125,250,500,1000,2000,4000,8000],pollCodes=[8,4,2,1,132,130,129];\\n const modes=[\\u0027办公模式\\u0027,\\u0027均衡模式\\u0027,\\u0027火力模式\\u0027,\\u0027超核模式\\u0027,\\u0027竞技超核模式\\u0027,\\u0027狂暴竞技模式\\u0027];\\n const allowedModes=[[0,1],[0,1],[0,1,2],[1,2,3,4,5],[2,3,4,5],[3,4,5],[3,4,5]];\\n const buttonOffsets={左键:0,中键:4,右键:8,前进:20,后退:24,滚轮前滚:36,滚轮后滚:40,DIY键:52};\\n function integer(n,min,max){if(!Number.isInteger(n)||n\\u003cmin||n\\u003emax)throw Error(\\u0027参数超出设备范围\\u0027);return n;}\\n function query(address,length,data){integer(address,0,0xffffffff);integer(length,0,28);const payload=[165,data?165:164,length,address\\u0026255,(address\\u003e\\u003e\\u003e8)\\u0026255,(address\\u003e\\u003e\\u003e16)\\u0026255,(address\\u003e\\u003e\\u003e24)\\u0026255,...(data||[0])];return {name:address.toString(16),reportId:6,featureReportId:8,ack:1,readOnly:!data,payload:hex(payload),waitMs:30};}\\n function data(reply,length,offset=4){const b=unhex(reply.response||\\u0027\\u0027);if(reply.error||b[0]!==1||b.length\\u003coffset+length)throw Error(reply.error||\\u0027设备回复无效\\u0027);if(offset===4\\u0026\\u0026b.slice(1,4).some(v=\\u003ev!==0))throw Error(\\u0027寄存器回复头无效\\u0027);return b.slice(offset,offset+length);}\\n function keyCode(key){const s=String(key).trim().toUpperCase();if(/^[A-Z]$/.test(s))return s.charCodeAt(0)-65+4;if(/^[1-9]$/.test(s))return Number(s)+29;if(s===\\u00270\\u0027)return 39;if(/^F([1-9]|1[0-2])$/.test(s))return 57+Number(s.slice(1));const codes={ENTER:40,ESC:41,BACKSPACE:42,TAB:43,SPACE:44,DELETE:76,RIGHT:79,LEFT:80,DOWN:81,UP:82,CTRL:224,SHIFT:225,ALT:226,WIN:227,RCTRL:228,RSHIFT:229,RALT:230,RWIN:231};if(codes[s]!==undefined)return codes[s];throw Error(\\u0027不支持的键盘字符：\\u0027+key);}\\n const actions={左键:[3,0,1,0],右键:[3,0,2,0],中键:[3,0,4,0],前进:[3,0,16,0],后退:[3,0,8,0],禁用按键:[7,0,0,0],\\u0027DPI+\\u0027:[8,0,1,0],\\u0027DPI-\\u0027:[8,0,2,0],\\u0027DPI循环+\\u0027:[8,0,3,0],\\u0027DPI循环-\\u0027:[8,0,4,0],DIY键:[10,0,0,0],配置切换:[10,0,2,0],接收器切换:[10,0,3,0],火力键:[9,0,2,0],狙击键:[9,0,1,0],\\u0027播放 / 暂停\\u0027:[4,0,0,205],上一首:[4,0,0,182],下一首:[4,0,0,181],\\u0027音量+\\u0027:[4,0,0,233],\\u0027音量-\\u0027:[4,0,0,234],静音:[4,0,0,226]};\\n function encodeAction(label,button){if(label.startsWith(\\u0027键盘字符：\\u0027))return [0,0,keyCode(label.slice(5)),0];if(label.startsWith(\\u0027组合键：\\u0027)){const keys=label.slice(4).split(\\u0027+\\u0027).map(keyCode),mod=keys.filter(v=\\u003ev\\u003e=224\\u0026\\u0026v\\u003c=231),normal=keys.filter(v=\\u003ev\\u003c224);if(!normal.length||normal.length\\u003e2||new Set(keys).size!==keys.length)throw Error(\\u0027组合键需要一至两个普通键及修饰键\\u0027);return [2,normal[1]||0,mod.reduce((v,k)=\\u003ev|(1\\u003c\\u003c(k-224)),0),normal[0]];}if(label.startsWith(\\u0027宏定义 #\\u0027))return [5,0,integer(Number(label.slice(5))-1,0,11),0];if(label.startsWith(\\u0027滚轮\\u0027)){const isWheel=button.startsWith(\\u0027滚轮\\u0027);if(!isWheel)throw Error(\\u0027滚动动作仅可分配给滚轮\\u0027);const vertical=[\\u0027滚轮前滚\\u0027,\\u0027滚轮后滚\\u0027].includes(label),direction=[\\u0027滚轮后滚\\u0027,\\u0027滚轮右滚\\u0027].includes(label)?1:0;return [vertical?11:12,255,direction^(button===\\u0027滚轮后滚\\u0027?1:0),255];}if(!actions[label])throw Error(\\u0027未知按键动作：\\u0027+label);if(button.startsWith(\\u0027滚轮\\u0027)\\u0026\\u0026[5,8,9,10].includes(actions[label][0]))throw Error(\\u0027滚轮不支持宏或特殊功能\\u0027);return actions[label].slice();}\\n function labelAction(bytes,button){if(bytes.every(v=\\u003ev===255))return button.startsWith(\\u0027滚轮\\u0027)?button:\\u0027出厂默认\\u0027;for(const[label,code]of Object.entries(actions))if(hex(code)===hex(bytes))return label;if(bytes[0]===0){for(const key of \\u0027ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\\u0027.split(\\u0027\\u0027))if(keyCode(key)===bytes[2])return \\u0027键盘字符：\\u0027+key;return \\u0027键盘字符：\\u0027+(Object.keys({ENTER:40,ESC:41,TAB:43,SPACE:44}).find(k=\\u003ekeyCode(k)===bytes[2])||(\\u0027HID \\u0027+bytes[2]));}if(bytes[0]===2){const mods=[\\u0027Ctrl\\u0027,\\u0027Shift\\u0027,\\u0027Alt\\u0027,\\u0027Win\\u0027,\\u0027RCtrl\\u0027,\\u0027RShift\\u0027,\\u0027RAlt\\u0027,\\u0027RWin\\u0027].filter((_,i)=\\u003ebytes[2]\\u0026(1\\u003c\\u003ci));const normal=[bytes[3],bytes[1]].filter(Boolean).map(k=\\u003e{for(const s of \\u0027ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\\u0027.split(\\u0027\\u0027))if(keyCode(s)===k)return s;return Object.keys({ENTER:40,ESC:41,TAB:43,SPACE:44}).find(s=\\u003ekeyCode(s)===k)||(\\u0027HID \\u0027+k);});return \\u0027组合键：\\u0027+[...mods,...normal].join(\\u0027+\\u0027);}if(bytes[0]===5)return \\u0027宏定义 #\\u0027+(bytes[2]+1);if(bytes[0]===11||bytes[0]===12){const backwards=bytes[2]^(button===\\u0027滚轮后滚\\u0027?1:0);return bytes[0]===11?(backwards?\\u0027滚轮后滚\\u0027:\\u0027滚轮前滚\\u0027):(backwards?\\u0027滚轮右滚\\u0027:\\u0027滚轮左滚\\u0027);}return \\u0027已保存映射 \\u0027+hex(bytes);}\\n function macroBytes(text,loop=1){integer(loop,1,65533);const events=[],pressed=new Set();let delay=20;for(const line of text.split(/\\\\r?\\\\n/)){if(!line.trim())continue;const wait=line.trim().match(/^延迟\\\\s+(\\\\d+)$/);if(wait){delay=integer(Number(wait[1]),0,32767);continue;}const m=line.trim().match(/^(按下|抬起)\\\\s+(.+)$/);if(!m)throw Error(\\u0027宏格式：按下 A、抬起 A、延迟 20\\u0027);const k=keyCode(m[2]),down=m[1]===\\u0027按下\\u0027;if(down===pressed.has(k))throw Error(\\u0027宏按下与抬起必须成对\\u0027);if(down)pressed.add(k);else pressed.delete(k);const encoded=(delay\\u003c\\u003c1)|(down?1:0);events.push(encoded\\u0026255,encoded\\u003e\\u003e8,k);delay=20;}if(pressed.size||!events.length)throw Error(\\u0027宏必须包含完整的按下及抬起\\u0027);const length=events.length+4;if(length\\u003e4096)throw Error(\\u0027宏超过 4096 字节\\u0027);return [length\\u0026255,length\\u003e\\u003e8,loop\\u0026255,loop\\u003e\\u003e8,...events];}\\n class Device{\\n  constructor(transport){this.transport=transport;this.configIndex=null;this.snapshot=null;this.queue=Promise.resolve();}\\n  run(fn){const p=this.queue.then(fn,fn);this.queue=p.catch(()=\\u003e{});return p;}\\n  async commands(commands){let replies=[];for(let i=0;i\\u003ccommands.length;i+=8){const result=await this.transport({match,queries:commands.slice(i,i+8)});if(!result?.ok)throw Error(result?.error||\\u0027设备未连接\\u0027);if(result.outputReportLength!==33||result.featureReportLength!==33)throw Error(\\u0027设备报告描述与 VT3S MAX 不匹配\\u0027);if(result.transactions.length!==Math.min(8,commands.length-i))throw Error(\\u0027事务回复不完整\\u0027);replies.push(...result.transactions);}return replies;}\\n  base(){if(this.configIndex===null)throw Error(\\u0027请先读取设备\\u0027);return 0x600+this.configIndex*0x400;}\\n  async readMany(fields){const replies=await this.commands(fields.map(f=\\u003equery(f.address,f.length)));return Object.fromEntries(fields.map((f,i)=\\u003e[f.name,data(replies[i],f.length)]));}\\n  async readSnapshot(){const c=await this.readMany([{name:\\u0027config\\u0027,address:0x10c,length:1}]);this.configIndex=integer(c.config[0],0,7);const base=this.base();const fields=[{name:\\u0027perf\\u0027,address:base+0x280,length:8},{name:\\u0027params\\u0027,address:base+0x2c0,length:6},{name:\\u0027radio\\u0027,address:base+0x2d8,length:3},{name:\\u0027modes\\u0027,address:base+0x2dc,length:7},{name:\\u0027x\\u0027,address:base+0x288,length:14},{name:\\u0027y\\u0027,address:base+0x2c8,length:14},{name:\\u0027count\\u0027,address:base+0x296,length:1},{name:\\u0027selected\\u0027,address:base+0x298,length:1},{name:\\u0027protocol\\u0027,address:0x60,length:1},...Object.entries(buttonOffsets).map(([name,offset])=\\u003e({name,address:base+offset,length:4}))];const raw=await this.readMany(fields);const count=integer(raw.count[0]+1,1,7),selected=integer(raw.selected[0],0,count-1);const u16=b=\\u003eArray.from({length:7},(_,i)=\\u003eb[i*2]|(b[i*2+1]\\u003c\\u003c8));const xs=u16(raw.x),ys=u16(raw.y),poll=pollCodes.indexOf(raw.perf[0]);if(poll\\u003c0)throw Error(\\u0027未知回报率\\u0027);const p=raw.params,r=raw.radio;const s={configIndex:this.configIndex,stages:xs.slice(0,count),axisY:ys.slice(0,count),selected,x:xs[selected],y:ys[selected],independent:xs[selected]!==ys[selected],polling:polls[poll],scan:[1000,2000,4000,8000][raw.perf[1]-3],lod:(raw.perf[4]+6)/10,motion:raw.perf[5]===1,press:p[0],release:p[1],sleep:p[2]!==255,minutes:p[2]===255?5:p[2],straight:!(p[3]\\u00261),ripple:!(p[3]\\u00262),angle:p[4]\\u003e127?p[4]-256:p[4],glass:p[5]===1,radio:r[0]===1?\\u0027满格射频\\u0027:\\u0027智能调节\\u0027,lowBattery:r[1]===1,protocol:raw.protocol[0]===0?\\u0027高效协议 turbo\\u0027:\\u0027初始协议\\u0027,mode:modes[raw.modes[poll]],buttons:Object.fromEntries(Object.keys(buttonOffsets).map(b=\\u003e[b,labelAction(raw[b],b)])),raw};this.snapshot=s;return s;}\\n  read(){return this.run(()=\\u003ethis.readSnapshot());}\\n  async writeVerified(address,bytes){if(bytes.some(n=\\u003e!Number.isInteger(n)||n\\u003c0||n\\u003e255)||bytes.length\\u003e24)throw Error(\\u0027写入字节无效\\u0027);const verify=query(address,bytes.length);verify.expected=hex(bytes);const replies=await this.commands([query(address,bytes.length,bytes),verify]);if(hex(data(replies[1],bytes.length))!==hex(bytes))throw Error(\\u0027设备回读不一致\\u0027);}\\n  async checkConfig(){const c=await this.readMany([{name:\\u0027config\\u0027,address:0x10c,length:1}]);if(c.config[0]!==this.configIndex)throw Error(\\u0027设备配置已切换，请重新读取\\u0027);}\\n  apply(draft,keys){return this.run(async()=\\u003e{if(!this.snapshot)throw Error(\\u0027请先读取设备\\u0027);await this.checkConfig();const base=this.base(),writes=[],before=this.snapshot,add=(offset,bytes)=\\u003ewrites.push({address:base+offset,bytes});const pollIndex=polls.indexOf(draft.polling);if(pollIndex\\u003c0)throw Error(\\u0027不支持的回报率\\u0027);\\n   if(keys.includes(\\u0027dpi\\u0027)){if(!draft.stages.length||draft.stages.length\\u003e7||draft.axisY.length!==draft.stages.length)throw Error(\\u0027设备支持 1 至 7 档\\u0027);const xs=draft.stages.map(v=\\u003einteger(v,50,30000)),ys=draft.axisY.map(v=\\u003einteger(v,50,30000));if([...xs,...ys].some(v=\\u003ev%50))throw Error(\\u0027DPI 步进为 50\\u0027);if(new Set(xs).size!==xs.length)throw Error(\\u0027DPI 档位不能重复\\u0027);add(0x288,xs.flatMap(v=\\u003e[v\\u0026255,v\\u003e\\u003e8]));add(0x2c8,ys.flatMap(v=\\u003e[v\\u0026255,v\\u003e\\u003e8]));add(0x296,[xs.length-1]);add(0x298,[integer(draft.selected,0,xs.length-1)]);}\\n   if(keys.includes(\\u0027polling\\u0027))add(0x280,[pollCodes[pollIndex]]);\\n   if(keys.includes(\\u0027mode\\u0027)||keys.includes(\\u0027polling\\u0027)){const mode=modes.indexOf(draft.mode);if(!allowedModes[pollIndex].includes(mode))throw Error(\\u0027此性能模式不支持当前回报率\\u0027);add(0x2dc+pollIndex,[mode]);}\\n   const scalar={scan:[0x281,()=\\u003einteger([1000,2000,4000,8000].indexOf(draft.scan)+3,3,6)],lod:[0x284,()=\\u003einteger(Math.round(draft.lod*10)-6,1,11)],motion:[0x285,()=\\u003edraft.motion?1:0],press:[0x2c0,()=\\u003einteger(draft.press,0,32)],release:[0x2c1,()=\\u003einteger(draft.release,0,32)],minutes:[0x2c2,()=\\u003edraft.sleep?integer(draft.minutes,2,120):255],sleep:[0x2c2,()=\\u003edraft.sleep?integer(draft.minutes,2,120):255],angle:[0x2c4,()=\\u003einteger(draft.angle,-30,30)\\u0026255],glass:[0x2c5,()=\\u003edraft.glass?1:0],radio:[0x2d8,()=\\u003edraft.radio===\\u0027满格射频\\u0027?1:0],lowBattery:[0x2d9,()=\\u003edraft.lowBattery?1:0]};for(const[key,[offset,encode]]of Object.entries(scalar))if(keys.includes(key))add(offset,[encode()]);\\n   if(keys.includes(\\u0027straight\\u0027)||keys.includes(\\u0027ripple\\u0027))add(0x2c3,[(before.raw.params[3]\\u0026252)|(draft.straight?0:1)|(draft.ripple?0:2)]);\\n   if(keys.includes(\\u0027protocol\\u0027)){if(draft.protocol===\\u0027高效协议 turbo\\u0027\\u0026\\u0026!this.versions)throw Error(\\u0027请先读取固件确认接收器能力\\u0027);writes.push({address:0x60,bytes:[draft.protocol===\\u0027高效协议 turbo\\u0027?0:2]});}\\n   for(const button of Object.keys(buttonOffsets))if(keys.includes(\\u0027button:\\u0027+button)){const label=draft.buttons[button];add(buttonOffsets[button],encodeAction(label,button));}\\n   const originals=await this.readMany(writes.map((w,i)=\\u003e({name:String(i),address:w.address,length:w.bytes.length})));const done=[];try{for(const[i,w]of writes.entries()){done.push(i);await this.writeVerified(w.address,w.bytes);}const actual=await this.readSnapshot();for(const button of Object.keys(buttonOffsets))if(keys.includes(\\u0027button:\\u0027+button)\\u0026\\u0026hex(actual.raw[button])!==hex(encodeAction(draft.buttons[button],button)))throw Error(\\u0027按键最终回读不一致\\u0027);return actual;}catch(error){const failures=[];for(const i of done.reverse())try{await this.writeVerified(writes[i].address,originals[String(i)]);}catch(e){failures.push(e.message);}try{await this.readSnapshot();}catch{}throw Error(error.message+(failures.length?\\u0027；恢复未完成，请重新读取：\\u0027+failures.join(\\u0027 / \\u0027):\\u0027；已恢复修改前配置\\u0027));}\\n  });}\\n  firmware(){return this.run(async()=\\u003e{const commands=[{name:\\u0027mouseUSB\\u0027,payload:\\u0027A5 A3 00\\u0027},{name:\\u0027mouseMCU\\u0027,payload:\\u0027A5 A3 01\\u0027},{name:\\u0027receiverUSB\\u0027,payload:\\u0027B0 00\\u0027},{name:\\u0027receiverMCU\\u0027,payload:\\u0027B0 01\\u0027}].map(q=\\u003e({...q,reportId:6,featureReportId:8,ack:1,readOnly:true,waitMs:30}));const replies=await this.commands(commands);this.versions=Object.fromEntries(replies.map((r,i)=\\u003e{const b=data(r,8,1),v=(b[0]|b[1]\\u003c\\u003c8|b[2]\\u003c\\u003c16|b[3]\\u003c\\u003c24)\\u003e\\u003e\\u003e0;return [commands[i].name,{version:(Math.floor(v/100)-(i===3\\u0026\\u0026b[6]===5\\u0026\\u0026b[7]===0?1:0))+\\u0027.\\u0027+v%100,chip:b[6],raw:r.response}];}));return this.versions;});}\\n  async readBlock(address,length){const fields=[];for(let i=0;i\\u003clength;i+=24)fields.push({name:String(i),address:address+i,length:Math.min(24,length-i)});const values=await this.readMany(fields);return fields.flatMap(f=\\u003evalues[f.name]);}\\n  async writeBlock(address,bytes){for(let i=0;i\\u003cbytes.length;i+=24)await this.writeVerified(address+i,bytes.slice(i,i+24));}\\n  async writeMacroBlock(address,bytes){for(let i=0;i\\u003cbytes.length;i+=24)await this.commands([query(address+i,Math.min(24,bytes.length-i),bytes.slice(i,i+24))]);}\\n  async activateMacro(address){await this.commands([query(address+1,0,[])]);}\\n  macroSlot(slot){return this.run(async()=\\u003e{integer(slot,0,11);const name=(await this.readMany([{name:\\u0027name\\u0027,address:0xfd00+slot*16,length:16}])).name;return {slot,empty:name[0]===0||name[0]===10||name.every(v=\\u003ev===255),nameBytes:name};});}\\n  writeMacro(text,slot,loop=1){return this.run(async()=\\u003e{integer(slot,0,11);await this.checkConfig();const bytes=macroBytes(text,loop),address=0x10000+slot*0x1000,nameAddress=0xfd00+slot*16;const header=await this.readBlock(address,4),oldLength=header[0]|header[1]\\u003c\\u003c8;const length=Math.max(bytes.length,oldLength\\u003e=4\\u0026\\u0026oldLength\\u003c=4096?oldLength:4);const original=await this.readBlock(address,length),name=await this.readBlock(nameAddress,16);let started=false;try{started=true;await this.writeMacroBlock(address,bytes);await this.activateMacro(address);const nextName=Array(16).fill(0);Array.from(\\u0027HhubMacro\\u0027+(slot+1)).forEach((c,i)=\\u003enextName[i]=c.charCodeAt(0));await this.writeMacroBlock(nameAddress,nextName);await this.activateMacro(nameAddress);const actual=await this.readBlock(address,bytes.length);if(hex(actual)!==hex(bytes))throw Error(\\u0027宏激活后回读不一致\\u0027);return {slot,events:(bytes.length-4)/3,loop,verified:true};}catch(error){if(started)try{await this.writeMacroBlock(address,original);await this.activateMacro(address);await this.writeMacroBlock(nameAddress,name);await this.activateMacro(nameAddress);}catch(restore){throw Error(error.message+\\u0027；宏恢复失败：\\u0027+restore.message);}throw error;}});}\\n  factoryReset(){return this.run(async()=\\u003e{await this.commands([{name:\\u0027factoryReset\\u0027,payload:\\u0027A5 AD 52 3D\\u0027,reportId:6,featureReportId:8,ack:1,readOnly:false,waitMs:200}]);return this.readSnapshot();});}\\n }\\n return {Device,match,polls,pollCodes,modes,allowedModes,buttonOffsets,query,data,keyCode,encodeAction,labelAction,macroBytes,hex};\\n})();\\n\\u003c/script\\u003e\\u003cscript\\u003ewindow.hhubFirmwareLinks={\\n  \\\"checkedOn\\\": \\\"2026-10-11\\\",\\n  \\\"source\\\": \\\"https://hub.rapoo.cn/\\\",\\n  \\\"links\\\": [\\n    {\\n      \\\"label\\\": \\\"鼠标 USB 固件\\\",\\n      \\\"version\\\": \\\"0.41\\\",\\n      \\\"url\\\": \\\"https://soft.rapoo.com/RapooDriver/Firmware/VT3S%20MAX/mouse_wch_v305_app_v0.41.zip\\\"\\n    },\\n    {\\n      \\\"label\\\": \\\"鼠标 MCU 固件\\\",\\n      \\\"version\\\": \\\"1.45\\\",\\n      \\\"url\\\": \\\"https://soft.rapoo.com/RapooDriver/Firmware/VT3S%20MAX/mouse_nordic_l15_transparent_v1.45.zip\\\"\\n    },\\n    {\\n      \\\"label\\\": \\\"接收器 USB 固件\\\",\\n      \\\"version\\\": \\\"0.41\\\",\\n      \\\"url\\\": \\\"https://soft.rapoo.com/RapooDriver/Firmware/Dongle_NordicL5/dongle_wch_v305_app_v0.41.zip\\\"\\n    },\\n    {\\n      \\\"label\\\": \\\"接收器 MCU 固件\\\",\\n      \\\"version\\\": \\\"1.6\\\",\\n      \\\"url\\\": \\\"https://soft.rapoo.com/RapooDriver/Firmware/Dongle_NordicL5/dongle_nordic_l5_transparent_v2.06.zip\\\"\\n    }\\n  ]\\n};window.hhubRapooImage=\\\"data:image/png;base64,\\\";\\u0027use strict\\u0027;\\nconst KEY=\\u0027hhub.rapoo.vt3s-max.ui.v1\\u0027;\\nconst defaults=()=\\u003e({schema:\\u0027hhub.rapoo-ui/1\\u0027,stages:[400,800,1200,1600,3200,6400,30000],axisY:[400,800,1200,1600,3200,6400,30000],selected:1,x:800,y:800,independent:false,buttons:{左键:\\u0027左键\\u0027,右键:\\u0027右键\\u0027,中键:\\u0027中键\\u0027,前进:\\u0027前进\\u0027,后退:\\u0027后退\\u0027,滚轮前滚:\\u0027滚轮前滚\\u0027,滚轮后滚:\\u0027滚轮后滚\\u0027,DIY键:\\u0027DIY键\\u0027},macro:\\u0027\\u0027,macroSlot:0,macroLoop:1,key:\\u0027\\u0027,combo:\\u0027\\u0027,radio:\\u0027智能调节\\u0027,protocol:\\u0027初始协议\\u0027,mode:\\u0027竞技超核模式\\u0027,scan:2000,polling:2000,motion:false,straight:false,ripple:false,glass:false,lod:1.1,angle:0,press:4,release:4,sleep:true,minutes:5,lowBattery:true,color:\\u0027星空黑\\u0027});\\nlet state=defaults(),tab=0,selectedButton=\\u0027左键\\u0027,category=\\u0027常规\\u0027,delay=\\u0027press\\u0027;\\nconst $=id=\\u003edocument.getElementById(id),esc=v=\\u003eString(v).replace(/[\\u0026\\u003c\\u003e\\\"\\u0027]/g,c=\\u003e({\\u0027\\u0026\\u0027:\\u0027\\u0026amp;\\u0027,\\u0027\\u003c\\u0027:\\u0027\\u0026lt;\\u0027,\\u0027\\u003e\\u0027:\\u0027\\u0026gt;\\u0027,\\u0027\\\"\\u0027:\\u0027\\u0026quot;\\u0027,\\\"\\u0027\\\":\\u0027\\u0026#39;\\u0027}[c]));\\nfunction validate(s){const d=defaults();s={...d,...s,axisY:s?.axisY||s?.stages?.slice()};if(!s||s.schema!==d.schema)throw Error(\\u0027不支持的草稿格式\\u0027);for(const k of Object.keys(d)){if(typeof s[k]!==typeof d[k])throw Error(\\u0027草稿字段不完整：\\u0027+k);}if(!Array.isArray(s.stages)||s.stages.length\\u003c1||s.stages.length\\u003e7||s.stages.some(v=\\u003e!Number.isInteger(v)||v\\u003c50||v\\u003e30000)||new Set(s.stages).size!==s.stages.length)throw Error(\\u0027DPI 档位无效\\u0027);if(!Array.isArray(s.axisY)||s.axisY.length!==s.stages.length||s.axisY.some(v=\\u003e!Number.isInteger(v)||v\\u003c50||v\\u003e30000))throw Error(\\u0027纵向 DPI 档位无效\\u0027);const bounds={macroSlot:[0,11],macroLoop:[1,65533],selected:[0,s.stages.length-1],x:[50,30000],y:[50,30000],lod:[.7,1.7],angle:[-30,30],press:[0,32],release:[0,32],minutes:[2,120]};for(const[k,[a,b]]of Object.entries(bounds))if(!Number.isFinite(s[k])||s[k]\\u003ca||s[k]\\u003eb)throw Error(\\u0027参数超出范围：\\u0027+k);for(const[k,list]of Object.entries({scan:[1000,2000,4000,8000],polling:[125,250,500,1000,2000,4000,8000],radio:[\\u0027智能调节\\u0027,\\u0027满格射频\\u0027],protocol:[\\u0027高效协议 turbo\\u0027,\\u0027初始协议\\u0027],mode:[\\u0027狂暴竞技模式\\u0027,\\u0027竞技超核模式\\u0027,\\u0027超核模式\\u0027,\\u0027火力模式\\u0027,\\u0027均衡模式\\u0027,\\u0027办公模式\\u0027],color:[\\u0027星空黑\\u0027,\\u0027皎月白\\u0027,\\u0027炫光黄\\u0027,\\u0027树莓粉\\u0027]}))if(!list.includes(s[k]))throw Error(\\u0027未知选项：\\u0027+k);if(!s.buttons||Array.isArray(s.buttons)||Object.keys(d.buttons).some(k=\\u003etypeof s.buttons[k]!==\\u0027string\\u0027||s.buttons[k].length\\u003e200))throw Error(\\u0027按键映射无效\\u0027);return Object.fromEntries(Object.keys(d).map(k=\\u003e[k,s[k]]));}\\ntry{const saved=localStorage.getItem(KEY);if(saved)state=validate(JSON.parse(saved));}catch(e){$(\\u0027status\\u0027).textContent=\\u0027未载入旧草稿：\\u0027+e.message;}\\nconst chip=(items,key)=\\u003e`\\u003cdiv class=\\\"chips\\\"\\u003e${items.map(v=\\u003e`\\u003cbutton data-set=\\\"${key}\\\" data-value=\\\"${esc(v)}\\\" class=\\\"${state[key]===v?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e${esc(v)}${typeof v===\\u0027number\\u0027?\\u0027 Hz\\u0027:\\u0027\\u0027}\\u003c/button\\u003e`).join(\\u0027\\u0027)}\\u003c/div\\u003e`;\\nconst range=(key,min,max,step,unit)=\\u003e`\\u003cdiv class=\\\"range-control\\\"\\u003e\\u003clabel\\u003e${key===\\u0027x\\u0027?\\u0027横向 DPI\\u0027:key===\\u0027y\\u0027?\\u0027纵向 DPI\\u0027:\\u0027\\u0027} \\u003cspan class=\\\"value\\\" data-output=\\\"${key}\\\"\\u003e${state[key]}${unit}\\u003c/span\\u003e\\u003c/label\\u003e\\u003cinput aria-label=\\\"${key}\\\" data-range=\\\"${key}\\\" type=\\\"range\\\" min=\\\"${min}\\\" max=\\\"${max}\\\" step=\\\"${step}\\\" value=\\\"${state[key]}\\\"\\u003e\\u003cinput aria-label=\\\"${key} 数值\\\" data-number=\\\"${key}\\\" type=\\\"number\\\" min=\\\"${min}\\\" max=\\\"${max}\\\" step=\\\"${step}\\\" value=\\\"${state[key]}\\\"\\u003e\\u003c/div\\u003e`;\\nconst toggle=(key,title,desc)=\\u003e`\\u003clabel class=\\\"switch\\\"\\u003e\\u003cspan\\u003e\\u003ch3\\u003e${title}\\u003c/h3\\u003e\\u003cspan class=\\\"hint\\\"\\u003e${desc}\\u003c/span\\u003e\\u003c/span\\u003e\\u003cinput aria-label=\\\"${title}\\\" type=\\\"checkbox\\\" data-check=\\\"${key}\\\" ${state[key]?\\u0027checked\\u0027:\\u0027\\u0027}\\u003e\\u003c/label\\u003e`;\\nfunction mouse(){if(window.hhubRapooImage)return `\\u003cimg class=\\\"mouse-art\\\" style=\\\"object-fit:contain\\\" src=\\\"${window.hhubRapooImage}\\\" alt=\\\"雷柏 VT3S MAX 官方产品图\\\"\\u003e`;return `\\u003csvg class=\\\"mouse-art\\\" viewBox=\\\"0 0 320 350\\\" aria-label=\\\"鼠标示意图\\\" role=\\\"img\\\"\\u003e\\u003cdefs\\u003e\\u003clinearGradient id=\\\"shell\\\" x2=\\\"1\\\" y2=\\\"1\\\"\\u003e\\u003cstop stop-color=\\\"#4d5962\\\"/\\u003e\\u003cstop offset=\\\"1\\\" stop-color=\\\"#171f27\\\"/\\u003e\\u003c/linearGradient\\u003e\\u003c/defs\\u003e\\u003cpath d=\\\"M160 20C90 20 63 72 65 146L57 247Q55 324 160 332Q265 324 263 247L255 146C257 72 230 20 160 20Z\\\" fill=\\\"url(#shell)\\\"/\\u003e\\u003cpath d=\\\"M160 22V177M68 174Q160 190 252 174\\\" stroke=\\\"#111a23\\\" stroke-width=\\\"3\\\"/\\u003e\\u003crect x=\\\"149\\\" y=\\\"65\\\" width=\\\"22\\\" height=\\\"56\\\" rx=\\\"10\\\" fill=\\\"#10151c\\\" stroke=\\\"#697680\\\"/\\u003e\\u003cpath d=\\\"M75 140V168M72 181V210\\\" stroke=\\\"#91a3af\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\"/\\u003e\\u003ctext x=\\\"160\\\" y=\\\"273\\\" fill=\\\"#7d8b96\\\" text-anchor=\\\"middle\\\" font-size=\\\"17\\\"\\u003eVT3S MAX\\u003c/text\\u003e\\u003c/svg\\u003e`;}\\nfunction render(){const names=[\\u0027DPI 设置\\u0027,\\u0027改键\\u0027,\\u0027性能\\u0027,\\u0027参数\\u0027,\\u0027鼠标设置\\u0027];$(\\u0027tabs\\u0027).innerHTML=names.map((n,i)=\\u003e`\\u003cbutton data-tab=\\\"${i}\\\" aria-current=\\\"${tab===i?\\u0027page\\u0027:\\u0027false\\u0027}\\\" class=\\\"${tab===i?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e${n}\\u003c/button\\u003e`).join(\\u0027\\u0027);let html=\\u0027\\u0027;\\nif(tab===0)html=`\\u003cdiv class=\\\"grid dpi-grid\\\"\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003eDPI 设置\\u003c/h2\\u003e\\u003cdiv class=\\\"large\\\"\\u003e${state.x}\\u003csmall\\u003e DPI\\u003c/small\\u003e\\u003c/div\\u003e${toggle(\\u0027independent\\u0027,\\u0027X / Y 独立设置\\u0027,\\u0027分别调整横向与纵向灵敏度\\u0027)}${range(\\u0027x\\u0027,50,30000,50,\\u0027 DPI\\u0027)}${state.independent?range(\\u0027y\\u0027,50,30000,50,\\u0027 DPI\\u0027):\\u0027\\u0027}\\u003cp class=\\\"hint\\\"\\u003e设备支持 50–30000 DPI，最多七档。\\u003c/p\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"card wide\\\"\\u003e\\u003cdiv class=\\\"split\\\"\\u003e\\u003ch2\\u003eDPI 档位\\u003c/h2\\u003e\\u003cbutton id=\\\"add-stage\\\"\\u003e添加档位\\u003c/button\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"chips\\\"\\u003e${state.stages.map((v,i)=\\u003e`\\u003cdiv class=\\\"stage\\\"\\u003e\\u003cbutton data-stage=\\\"${i}\\\" class=\\\"${i===state.selected?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e${v}\\u003c/button\\u003e\\u003cbutton class=\\\"remove\\\" aria-label=\\\"删除 ${v} 档位\\\" data-remove=\\\"${i}\\\" ${state.stages.length===1?\\u0027disabled\\u0027:\\u0027\\u0027}\\u003e×\\u003c/button\\u003e\\u003c/div\\u003e`).join(\\u0027\\u0027)}\\u003c/div\\u003e\\u003cp class=\\\"hint\\\"\\u003e档位增删与数值修改后，自动写入鼠标。\\u003c/p\\u003e\\u003c/div\\u003e\\u003c/div\\u003e`;\\nif(tab===1){const actions={常规:[\\u0027左键\\u0027,\\u0027中键\\u0027,\\u0027右键\\u0027,\\u0027滚轮前滚\\u0027,\\u0027滚轮后滚\\u0027,\\u0027滚轮左滚\\u0027,\\u0027滚轮右滚\\u0027,\\u0027前进\\u0027,\\u0027后退\\u0027,\\u0027DPI+\\u0027,\\u0027DPI-\\u0027,\\u0027DIY键\\u0027,\\u0027火力键\\u0027,\\u0027狙击键\\u0027,\\u0027DPI循环+\\u0027,\\u0027DPI循环-\\u0027,\\u0027配置切换\\u0027,\\u0027接收器切换\\u0027,\\u0027禁用按键\\u0027],多媒体:[\\u0027播放 / 暂停\\u0027,\\u0027上一首\\u0027,\\u0027下一首\\u0027,\\u0027音量+\\u0027,\\u0027音量-\\u0027,\\u0027静音\\u0027]};html=`\\u003cdiv class=\\\"grid\\\"\\u003e\\u003cdiv class=\\\"card mouse-panel\\\"\\u003e${mouse()}\\u003cdiv class=\\\"chips hotspots\\\"\\u003e${Object.keys(state.buttons).map(b=\\u003e`\\u003cbutton data-button=\\\"${b}\\\" class=\\\"${b===selectedButton?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e${b}\\u003c/button\\u003e`).join(\\u0027\\u0027)}\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e${esc(selectedButton)} · 按键功能\\u003c/h2\\u003e\\u003cp\\u003e当前映射：\\u003cstrong\\u003e${esc(state.buttons[selectedButton])}\\u003c/strong\\u003e\\u003c/p\\u003e\\u003cdiv class=\\\"chips\\\"\\u003e${[\\u0027常规\\u0027,\\u0027多媒体\\u0027,\\u0027键盘字符\\u0027,\\u0027组合键\\u0027,\\u0027宏定义\\u0027].map(c=\\u003e`\\u003cbutton data-category=\\\"${c}\\\" class=\\\"${c===category?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e${c}\\u003c/button\\u003e`).join(\\u0027\\u0027)}\\u003c/div\\u003e\\u003chr style=\\\"border:0;border-top:1px solid var(--line);margin:24px 0\\\"\\u003e${actions[category]?`\\u003cdiv class=\\\"chips\\\"\\u003e${actions[category].map(a=\\u003e`\\u003cbutton data-action=\\\"${a}\\\" class=\\\"${state.buttons[selectedButton]===a?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e${a}\\u003c/button\\u003e`).join(\\u0027\\u0027)}\\u003c/div\\u003e`:category===\\u0027宏定义\\u0027?\\u0027\\u003cdiv class=\\\"row\\\"\\u003e\\u003clabel\\u003e鼠标宏槽位\\u003cselect id=\\\"macro-slot\\\"\\u003e\\u0027+Array.from({length:12},(_,i)=\\u003e\\u0027\\u003coption value=\\\"\\u0027+i+\\u0027\\\" \\u0027+(state.macroSlot===i?\\u0027selected\\u0027:\\u0027\\u0027)+\\u0027\\u003e\\u0027+(i+1)+\\u0027\\u003c/option\\u003e\\u0027).join(\\u0027\\u0027)+\\u0027\\u003c/select\\u003e\\u003c/label\\u003e\\u003clabel\\u003e循环次数\\u003cinput id=\\\"macro-loop\\\" type=\\\"number\\\" min=\\\"1\\\" max=\\\"65533\\\" value=\\\"\\u0027+state.macroLoop+\\u0027\\\"\\u003e\\u003c/label\\u003e\\u003c/div\\u003e\\u003clabel\\u003e宏步骤（按下 / 抬起 / 延迟 毫秒）\\u003ctextarea id=\\\"macro\\\" placeholder=\\\"按下 Ctrl\\\\n按下 C\\\\n抬起 C\\\\n抬起 Ctrl\\\"\\u003e\\u0027+esc(state.macro)+\\u0027\\u003c/textarea\\u003e\\u003c/label\\u003e\\u0027:`\\u003clabel\\u003e${category===\\u0027组合键\\u0027?\\u0027组合键，例如 Ctrl+Shift+S\\u0027:\\u0027键盘字符，例如 A\\u0027}\\u003cinput id=\\\"custom-key\\\" type=\\\"text\\\" maxlength=\\\"100\\\" value=\\\"${esc(category===\\u0027组合键\\u0027?state.combo:state.key)}\\\"\\u003e\\u003c/label\\u003e\\u003cbutton id=\\\"assign-custom\\\"\\u003e绑定到 ${esc(selectedButton)}\\u003c/button\\u003e`}\\u003cp class=\\\"hint\\\"\\u003e选择功能后自动写入并回读确认。\\u003c/p\\u003e\\u003c/div\\u003e\\u003c/div\\u003e`;}\\nif(tab===2)html=`\\u003cdiv class=\\\"cards\\\"\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e无线射频策略\\u003c/h2\\u003e${chip([\\u0027智能调节\\u0027,\\u0027满格射频\\u0027],\\u0027radio\\u0027)}\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e通讯协议\\u003c/h2\\u003e${chip([\\u0027高效协议 turbo\\u0027,\\u0027初始协议\\u0027],\\u0027protocol\\u0027)}\\u003c/div\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e性能模式\\u003c/h2\\u003e${chip([\\u0027狂暴竞技模式\\u0027,\\u0027竞技超核模式\\u0027,\\u0027超核模式\\u0027,\\u0027火力模式\\u0027,\\u0027均衡模式\\u0027,\\u0027办公模式\\u0027],\\u0027mode\\u0027)}\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e按键扫描率\\u003c/h2\\u003e${chip([1000,2000,4000,8000],\\u0027scan\\u0027)}\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e回报率\\u003c/h2\\u003e${chip([125,250,500,1000,2000,4000,8000],\\u0027polling\\u0027)}\\u003cp class=\\\"hint\\\"\\u003e性能模式按回报率自动限制；修改后自动同步。\\u003c/p\\u003e\\u003c/div\\u003e`;\\nif(tab===3)html=`\\u003cdiv class=\\\"grid\\\"\\u003e\\u003cdiv class=\\\"card\\\"\\u003e${toggle(\\u0027motion\\u0027,\\u0027移动同步\\u0027,\\u0027提高移动追踪稳定性\\u0027)}${toggle(\\u0027straight\\u0027,\\u0027直线修正\\u0027,\\u0027修正直线移动中的偏移\\u0027)}${toggle(\\u0027ripple\\u0027,\\u0027波浪修正\\u0027,\\u0027平滑高 DPI 移动\\u0027)}${toggle(\\u0027glass\\u0027,\\u0027玻璃追踪技术\\u0027,\\u0027玻璃表面追踪选项\\u0027)}\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e光学引擎静默高度\\u003c/h2\\u003e${range(\\u0027lod\\u0027,.7,1.7,.1,\\u0027 mm\\u0027)}\\u003cp class=\\\"hint\\\"\\u003e参考原厂页面范围\\u003c/p\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e传感器角度\\u003c/h2\\u003e\\u003cdiv class=\\\"dial\\\"\\u003e\\u003cspan data-output=\\\"angle\\\"\\u003e${state.angle}°\\u003c/span\\u003e\\u003c/div\\u003e${range(\\u0027angle\\u0027,-30,30,1,\\u0027°\\u0027)}\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e按键防抖延迟\\u003c/h2\\u003e\\u003cdiv class=\\\"chips\\\"\\u003e\\u003cbutton data-delay=\\\"press\\\" class=\\\"${delay===\\u0027press\\u0027?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e按下去抖延迟\\u003c/button\\u003e\\u003cbutton data-delay=\\\"release\\\" class=\\\"${delay===\\u0027release\\u0027?\\u0027active\\u0027:\\u0027\\u0027}\\\"\\u003e抬起去抖延迟\\u003c/button\\u003e\\u003c/div\\u003e${range(delay,0,32,1,\\u0027 ms\\u0027)}\\u003c/div\\u003e\\u003c/div\\u003e`;\\nif(tab===4)html=`\\u003cdiv class=\\\"grid settings-grid\\\"\\u003e\\u003cdiv class=\\\"card\\\"\\u003e\\u003ch2\\u003e固件\\u003c/h2\\u003e\\u003cdiv class=\\\"split\\\"\\u003e\\u003cspan\\u003e鼠标 \\u003cstrong\\u003e${esc(window.hhubRapooFirmware?.mouseUSB?.version||\\u0027待读取\\u0027)}\\u003c/strong\\u003e\\u003c/span\\u003e\\u003cbutton data-firmware-info\\u003e更新版本信息\\u003c/button\\u003e\\u003c/div\\u003e\\u003cp\\u003e接收器 USB / MCU：${esc(window.hhubRapooFirmware?.receiverUSB?.version||\\u0027—\\u0027)} / ${esc(window.hhubRapooFirmware?.receiverMCU?.version||\\u0027—\\u0027)}\\u003c/p\\u003e\\u003ch3\\u003e原厂固件下载\\u003c/h3\\u003e\\u003cdiv class=\\\"chips\\\"\\u003e${(window.hhubFirmwareLinks?.links||[]).map(l=\\u003e`\\u003cbutton data-firmware-url=\\\"${esc(l.url)}\\\"\\u003e${esc(l.label)} · ${esc(l.version)}\\u003c/button\\u003e`).join(\\u0027\\u0027)}\\u003c/div\\u003e\\u003cp class=\\\"hint\\\"\\u003e下载不会刷写设备 · 清单 ${esc(window.hhubFirmwareLinks?.checkedOn||\\u0027—\\u0027)}\\u003c/p\\u003e\\u003c/div\\u003e\\u003cdiv class=\\\"card\\\"\\u003e${toggle(\\u0027sleep\\u0027,\\u0027无线休眠\\u0027,\\u0027未操作后进入休眠\\u0027)}${state.sleep?range(\\u0027minutes\\u0027,2,120,1,\\u0027 分钟\\u0027):\\u0027\\u0027}${toggle(\\u0027lowBattery\\u0027,\\u0027低电量灯\\u0027,\\u0027低电量时闪烁提醒\\u0027)}\\u003c/div\\u003e\\u003cdiv class=\\\"card wide split\\\"\\u003e\\u003cspan\\u003e恢复鼠标全部出厂配置\\u003c/span\\u003e\\u003cbutton id=\\\"factory-reset\\\"\\u003e恢复出厂\\u003c/button\\u003e\\u003c/div\\u003e\\u003c/div\\u003e`;\\n$(\\u0027page\\u0027).dataset.tab=String(tab);$(\\u0027page\\u0027).innerHTML=html;}\\nfunction changed(){ $(\\u0027status\\u0027).textContent=\\u0027草稿已修改 · 未写入设备\\u0027; }\\nfunction number(key,value,el){const n=Number(value),min=Number(el.min),max=Number(el.max),step=Number(el.step);if(!Number.isFinite(n)||n\\u003cmin||n\\u003emax||Math.abs((n-min)/step-Math.round((n-min)/step))\\u003e.001){$(\\u0027status\\u0027).textContent=\\u0027请输入范围内的有效数值\\u0027;return false;}if(key===\\u0027x\\u0027\\u0026\\u0026state.stages.some((v,i)=\\u003ei!==state.selected\\u0026\\u0026v===n)){$(\\u0027status\\u0027).textContent=\\u0027此 DPI 档位已存在\\u0027;return false;}state[key]=n;if(key===\\u0027x\\u0027){state.stages[state.selected]=n;if(!state.independent){state.y=n;state.axisY[state.selected]=n;}}if(key===\\u0027y\\u0027)state.axisY[state.selected]=n;changed();return true;}\\ndocument.addEventListener(\\u0027input\\u0027,e=\\u003e{const el=e.target;if(el.dataset.range){if(number(el.dataset.range,el.value,el)){document.querySelectorAll(`[data-output=\\\"${el.dataset.range}\\\"]`).forEach(o=\\u003eo.textContent=el.value+({lod:\\u0027 mm\\u0027,angle:\\u0027°\\u0027,press:\\u0027 ms\\u0027,release:\\u0027 ms\\u0027,minutes:\\u0027 分钟\\u0027,x:\\u0027 DPI\\u0027,y:\\u0027 DPI\\u0027}[el.dataset.range]||\\u0027\\u0027));const num=document.querySelector(`[data-number=\\\"${el.dataset.range}\\\"]`);if(num)num.value=el.value;}}});\\ndocument.addEventListener(\\u0027change\\u0027,e=\\u003e{const el=e.target;if(el.dataset.check){state[el.dataset.check]=el.checked;if(el.dataset.check===\\u0027independent\\u0027\\u0026\\u0026!state.independent){state.y=state.x;state.axisY[state.selected]=state.x;}changed();setTimeout(render,0);}if(el.dataset.number){number(el.dataset.number,el.value,el);setTimeout(render,0);}if(el.dataset.range)setTimeout(render,0);});\\ndocument.addEventListener(\\u0027click\\u0027,e=\\u003e{const el=e.target.closest(\\u0027button\\u0027);if(!el)return;const d=el.dataset;if(d.tab!==undefined){tab=Number(d.tab);render();return;}if(d.stage!==undefined){state.selected=Number(d.stage);state.x=state.stages[state.selected];state.y=state.axisY[state.selected];state.independent=state.x!==state.y;}else if(d.remove!==undefined){if(state.stages.length===1)return;state.stages.splice(Number(d.remove),1);state.axisY.splice(Number(d.remove),1);state.selected=Math.min(state.selected,state.stages.length-1);state.x=state.stages[state.selected];state.y=state.axisY[state.selected];state.independent=state.x!==state.y;}else if(d.set){state[d.set]=typeof state[d.set]===\\u0027number\\u0027?Number(d.value):d.value;}else if(d.button){selectedButton=d.button;render();return;}else if(d.category){category=d.category;render();return;}else if(d.action){state.buttons[selectedButton]=d.action;}else if(d.delay){delay=d.delay;render();return;}else if(el.id===\\u0027add-stage\\u0027){if(state.stages.length\\u003e=7){$(\\u0027status\\u0027).textContent=\\u0027设备最多支持 7 个档位\\u0027;return;}let v=30000;while(state.stages.includes(v)\\u0026\\u0026v\\u003e=50)v-=50;state.stages.push(v);state.axisY.push(v);state.selected=state.stages.length-1;state.x=v;state.y=v;state.independent=false;}else if(el.id===\\u0027assign-custom\\u0027){const value=category===\\u0027宏定义\\u0027?$(\\u0027macro\\u0027).value:$(\\u0027custom-key\\u0027).value.trim();if(!value){$(\\u0027status\\u0027).textContent=\\u0027请先填写功能内容\\u0027;return;}if(category===\\u0027宏定义\\u0027){if(value.length\\u003e10000){$(\\u0027status\\u0027).textContent=\\u0027宏草稿过长\\u0027;return;}state.macro=value;state.macroSlot=Number($(\\u0027macro-slot\\u0027).value);state.macroLoop=Number($(\\u0027macro-loop\\u0027).value);state.buttons[selectedButton]=\\u0027宏定义 #\\u0027+(state.macroSlot+1);}else{state[category===\\u0027组合键\\u0027?\\u0027combo\\u0027:\\u0027key\\u0027]=value;state.buttons[selectedButton]=category+\\u0027：\\u0027+value;}}else if(el.id===\\u0027save\\u0027){try{localStorage.setItem(KEY,JSON.stringify(state));$(\\u0027status\\u0027).textContent=\\u0027草稿已保存到本机 · 未写入设备\\u0027;}catch(err){$(\\u0027status\\u0027).textContent=\\u0027保存失败：\\u0027+err.message;}return;}else if(el.id===\\u0027export\\u0027){const blob=new Blob([JSON.stringify(state,null,2)],{type:\\u0027application/json\\u0027}),url=URL.createObjectURL(blob),a=document.createElement(\\u0027a\\u0027);a.href=url;a.download=\\u0027VT3S-MAX-ui-draft.json\\u0027;a.click();setTimeout(()=\\u003eURL.revokeObjectURL(url),1000);$(\\u0027status\\u0027).textContent=\\u0027已导出本地草稿\\u0027;return;}else if(el.id===\\u0027import\\u0027){$(\\u0027file\\u0027).click();return;}else if(el.id===\\u0027reset\\u0027){if(!confirm(\\u0027重置本地草稿？尚未保存的修改会丢失。\\u0027))return;state=defaults();}else return;changed();render();});\\n$(\\u0027file\\u0027)?.addEventListener(\\u0027change\\u0027,async e=\\u003e{try{const f=e.target.files[0];if(!f)return;if(f.size\\u003e65536)throw Error(\\u0027草稿不能超过 64 KB\\u0027);const next=validate(JSON.parse(await f.text()));state=next;render();$(\\u0027status\\u0027).textContent=\\u0027草稿已导入 · 尚未保存或应用\\u0027;}catch(err){$(\\u0027status\\u0027).textContent=\\u0027导入失败：\\u0027+err.message;}finally{e.target.value=\\u0027\\u0027;}});render();\\n\\u003c/script\\u003e\\u003cscript\\u003elet liveBaseline=null,liveBusy=false,syncBusy=false,autoTimer=null;\\nconst liveWrittenMacros=new Map();\\nconst liveTransport=request=\\u003e{if(typeof window.hhubDeviceTransaction===\\u0027function\\u0027)return window.hhubDeviceTransaction(request);if(parent!==window\\u0026\\u0026typeof parent.hhubDeviceTransaction===\\u0027function\\u0027)return parent.hhubDeviceTransaction(request);return Promise.reject(Error(\\u0027请在 H hub 中连接鼠标\\u0027));};\\nconst liveDevice=new RapooProtocol.Device(liveTransport);\\nconst copy=value=\\u003eJSON.parse(JSON.stringify(value));\\nfunction liveKeys(){if(!liveBaseline)return [];const keys=[],equal=(a,b)=\\u003eJSON.stringify(a)===JSON.stringify(b);if([\\u0027stages\\u0027,\\u0027axisY\\u0027,\\u0027selected\\u0027].some(k=\\u003e!equal(state[k],liveBaseline[k])))keys.push(\\u0027dpi\\u0027);for(const k of [\\u0027polling\\u0027,\\u0027scan\\u0027,\\u0027mode\\u0027,\\u0027lod\\u0027,\\u0027motion\\u0027,\\u0027press\\u0027,\\u0027release\\u0027,\\u0027sleep\\u0027,\\u0027minutes\\u0027,\\u0027straight\\u0027,\\u0027ripple\\u0027,\\u0027angle\\u0027,\\u0027glass\\u0027,\\u0027radio\\u0027,\\u0027lowBattery\\u0027,\\u0027protocol\\u0027])if(!equal(state[k],liveBaseline[k]))keys.push(k);for(const b of Object.keys(RapooProtocol.buttonOffsets))if(state.buttons[b]!==liveBaseline.buttons[b])keys.push(\\u0027button:\\u0027+b);return keys;}\\nfunction liveAccept(actual){const {raw,configIndex,...values}=actual;state={...state,...values};liveBaseline=copy(state);render();}\\nfunction liveControls(){document.querySelectorAll(\\u0027#page button,#page input,#page textarea,#page select\\u0027).forEach(el=\\u003e{if(liveBusy||!liveBaseline){if(!el.disabled)el.dataset.liveDisabled=\\u00271\\u0027;el.disabled=true;}else if(el.dataset.liveDisabled){el.disabled=false;delete el.dataset.liveDisabled;}});const allowed=RapooProtocol.allowedModes[RapooProtocol.polls.indexOf(state.polling)]||[];document.querySelectorAll(\\u0027[data-set=mode]\\u0027).forEach(el=\\u003eel.disabled=liveBusy||!allowed.includes(RapooProtocol.modes.indexOf(el.dataset.value)));document.querySelectorAll(\\u0027[data-action]\\u0027).forEach(el=\\u003e{try{RapooProtocol.encodeAction(el.dataset.action,selectedButton);}catch{el.disabled=true;el.title=\\u0027此按键不支持该功能\\u0027;}});}\\nasync function liveOperation(fn){if(liveBusy)return;liveBusy=true;liveControls();try{await fn();}catch(error){if(liveDevice.snapshot)liveAccept(liveDevice.snapshot);$(\\u0027status\\u0027).textContent=error.message;}finally{liveBusy=false;liveControls();}}\\nasync function autoApply(){autoTimer=null;if(!liveBaseline)return;if(liveBusy||syncBusy){autoTimer=setTimeout(autoApply,120);return;}const keys=liveKeys();if(!keys.length){$(\\u0027status\\u0027).textContent=\\u0027已同步\\u0027;return;}await liveOperation(async()=\\u003e{if(keys.includes(\\u0027dpi\\u0027))state.axisY[state.selected]=state.independent?state.y:state.x;for(const key of keys.filter(k=\\u003ek.startsWith(\\u0027button:\\u0027))){const label=state.buttons[key.slice(7)];if(label.startsWith(\\u0027宏定义 #\\u0027)\\u0026\\u0026liveWrittenMacros.get(Number(label.slice(5))-1)!==JSON.stringify([state.macro,state.macroLoop]))throw Error(\\u0027请先写入宏槽再绑定\\u0027);}$(\\u0027status\\u0027).textContent=\\u0027正在同步…\\u0027;const actual=await liveDevice.apply(copy(state),keys);liveAccept(actual);$(\\u0027status\\u0027).textContent=\\u0027已同步 · 回读一致\\u0027;});}\\nfunction scheduleAuto(){clearTimeout(autoTimer);if(liveBaseline){$(\\u0027status\\u0027).textContent=\\u0027等待同步…\\u0027;autoTimer=setTimeout(autoApply,600);}}\\nconst oldChanged=changed;changed=()=\\u003e{oldChanged();scheduleAuto();};\\nconst oldRender=render;render=()=\\u003e{oldRender();if($(\\u0027macro\\u0027)){const button=document.createElement(\\u0027button\\u0027);button.textContent=\\u0027写入并绑定宏\\u0027;button.onclick=()=\\u003e{const text=$(\\u0027macro\\u0027).value,slot=Number($(\\u0027macro-slot\\u0027).value),loop=Number($(\\u0027macro-loop\\u0027).value);return liveOperation(async()=\\u003e{if(!liveBaseline)throw Error(\\u0027鼠标尚未连接\\u0027);RapooProtocol.macroBytes(text,loop);const info=await liveDevice.macroSlot(slot);if(!info.empty\\u0026\\u0026!confirm(\\u0027替换鼠标第 \\u0027+(slot+1)+\\u0027 个宏槽？\\u0027))return;$(\\u0027status\\u0027).textContent=\\u0027正在写入宏…\\u0027;const result=await liveDevice.writeMacro(text,slot,loop);state.macro=text;state.macroSlot=slot;state.macroLoop=loop;liveWrittenMacros.set(slot,JSON.stringify([text,loop]));state.buttons[selectedButton]=\\u0027宏定义 #\\u0027+(result.slot+1);render();scheduleAuto();});};$(\\u0027macro\\u0027).parentElement.after(button);}liveControls();};\\nfunction hardwareFingerprint(actual){return JSON.stringify(Object.fromEntries([\\u0027stages\\u0027,\\u0027axisY\\u0027,\\u0027selected\\u0027,\\u0027polling\\u0027,\\u0027scan\\u0027,\\u0027mode\\u0027,\\u0027lod\\u0027,\\u0027motion\\u0027,\\u0027press\\u0027,\\u0027release\\u0027,\\u0027sleep\\u0027,\\u0027minutes\\u0027,\\u0027straight\\u0027,\\u0027ripple\\u0027,\\u0027angle\\u0027,\\u0027glass\\u0027,\\u0027radio\\u0027,\\u0027lowBattery\\u0027,\\u0027protocol\\u0027,\\u0027buttons\\u0027].map(k=\\u003e[k,actual[k]])));}\\nasync function syncDevice(initial=false){if(liveBusy||syncBusy||autoTimer||document.hidden)return;if(!initial\\u0026\\u0026document.activeElement?.matches(\\u0027input[type=number],input[type=text],textarea,select\\u0027))return;syncBusy=true;try{const actual=await liveDevice.read();if(!liveBaseline){try{window.hhubRapooFirmware=await liveDevice.firmware();}catch{}liveAccept(actual);$(\\u0027status\\u0027).textContent=\\u0027已连接 · 自动同步\\u0027;document.querySelector(\\u0027.notice span:nth-child(2)\\u0027).textContent=\\u0027调整后自动生效\\u0027;}else if(!liveKeys().length\\u0026\\u0026hardwareFingerprint(actual)!==hardwareFingerprint(liveBaseline)){liveAccept(actual);$(\\u0027status\\u0027).textContent=\\u0027已同步鼠标变化\\u0027;}}catch(error){$(\\u0027status\\u0027).textContent=error.message;}finally{syncBusy=false;}}\\ndocument.addEventListener(\\u0027click\\u0027,e=\\u003e{const b=e.target.closest(\\u0027button\\u0027);if(!b)return;if(b.dataset.set===\\u0027polling\\u0027){const i=RapooProtocol.polls.indexOf(state.polling);if(!RapooProtocol.allowedModes[i].includes(RapooProtocol.modes.indexOf(state.mode))){state.mode=RapooProtocol.modes[Math.max(...RapooProtocol.allowedModes[i])];render();scheduleAuto();}}if(b.dataset.firmwareUrl)liveOperation(async()=\\u003e{await liveTransport({openLink:b.dataset.firmwareUrl});$(\\u0027status\\u0027).textContent=\\u0027已打开原厂下载，未执行刷写\\u0027;});if(b.hasAttribute(\\u0027data-firmware-info\\u0027))liveOperation(async()=\\u003e{window.hhubRapooFirmware=await liveDevice.firmware();render();$(\\u0027status\\u0027).textContent=\\u0027固件版本已刷新\\u0027;});if(b.id===\\u0027factory-reset\\u0027)liveOperation(async()=\\u003e{if(!confirm(\\u0027确认删除鼠标全部个性化配置并恢复出厂设置？\\u0027))return;liveAccept(await liveDevice.factoryReset());$(\\u0027status\\u0027).textContent=\\u0027已恢复出厂\\u0027;});});\\nconst batteryBadge=document.createElement(\\u0027output\\u0027);batteryBadge.id=\\u0027device-battery\\u0027;batteryBadge.textContent=\\u0027等待电量上报\\u0027;document.querySelector(\\u0027.notice\\u0027).append(batteryBadge);let batteryBusy=false;async function refreshBattery(){if(batteryBusy||liveBusy||document.hidden)return;batteryBusy=true;try{const r=await liveTransport({match:RapooProtocol.match,telemetry:true});batteryBadge.textContent=r.available?\\u0027电量 \\u0027+r.battery+\\u0027%\\u0027+(r.lowBattery?\\u0027 · 低电量\\u0027:\\u0027\\u0027):\\u0027等待电量上报\\u0027;}catch{batteryBadge.textContent=\\u0027电量暂不可用\\u0027;}finally{batteryBusy=false;}}\\nliveControls();setTimeout(()=\\u003esyncDevice(true),0);setInterval(()=\\u003esyncDevice(false),2500);setInterval(refreshBattery,3000);setTimeout(refreshBattery,1500);\\u003c/script\\u003e\\u003c/body\\u003e\\u003c/html\\u003e\\n\";\nconst hidPending=new Map();let hidToken=0;let hidQueue=Promise.resolve();\nwindow.hhubDeviceTransaction=request=\u003e{const run=()=\u003enew Promise((resolve,reject)=\u003e{if(!window.chrome?.webview){reject(Error(\u0027请在新版 H hub 开发者窗口内连接设备\u0027));return;}const token=\u0027hid-\u0027+(++hidToken);const timer=setTimeout(()=\u003e{hidPending.delete(token);reject(Error(\u0027通信超时，请重新读取设备确认状态\u0027));},12000);hidPending.set(token,{resolve,reject,timer});window.chrome.webview.postMessage({type:\u0027hhub.hid\u0027,token,body:{request}});});const result=hidQueue.then(run,run);hidQueue=result.catch(()=\u003e{});return result;};\nwindow.chrome?.webview?.addEventListener(\u0027message\u0027,e=\u003e{const m=e.data;if(m.type!==\u0027hhub.hid.result\u0027)return;const p=hidPending.get(m.token);if(!p)return;hidPending.delete(m.token);clearTimeout(p.timer);if(m.error)p.reject(Error(m.error));else p.resolve(m.result);});\nconst saved=(()=\u003e{try{return JSON.parse(localStorage.getItem(\u0027hhub.developer.projects\u0027)||\u0027{}\u0027)}catch{return {}}})();\nfunction escapeHtml(value){return String(value).replace(/[\u0026\u003c\u003e\"\u0027]/g,c=\u003e({\u0027\u0026\u0027:\u0027\u0026amp;\u0027,\u0027\u003c\u0027:\u0027\u0026lt;\u0027,\u0027\u003e\u0027:\u0027\u0026gt;\u0027,\u0027\"\u0027:\u0027\u0026quot;\u0027,\"\u0027\":\u0027\u0026#39;\u0027}[c]));}\nfunction download(name,value){const url=URL.createObjectURL(new Blob([JSON.stringify(value,null,2)],{type:\u0027application/json\u0027}));const a=document.createElement(\u0027a\u0027);a.href=url;a.download=name;a.click();setTimeout(()=\u003eURL.revokeObjectURL(url),30000);}\nfor(const template of HhubDev.templates){\n const detail=document.createElement(\u0027details\u0027);detail.dataset.kind=template.kind;\n detail.innerHTML=`\u003csummary\u003e${template.name}\u003csmall\u003e${template.description}\u003c/small\u003e\u003c/summary\u003e\u003cdiv class=\"environment\"\u003e\n \u003cdiv class=\"steps\"\u003e\u003cspan\u003e1 项目\u003c/span\u003e\u003cspan\u003e2 页面\u003c/span\u003e\u003cspan\u003e3 抓包\u003c/span\u003e\u003cspan\u003e4 差异\u003c/span\u003e\u003cspan\u003e5 绑定\u003c/span\u003e\u003cspan\u003e6 验证与导出\u003c/span\u003e\u003c/div\u003e\n \u003ch2\u003e项目与目标设备\u003c/h2\u003e\u003cdiv class=\"fields\"\u003e\u003clabel\u003e插件 ID\u003cinput data-field=\"id\" placeholder=\"community.my-device\"\u003e\u003c/label\u003e\u003clabel\u003e插件名称\u003cinput data-field=\"name\"\u003e\u003c/label\u003e\u003clabel\u003e作者\u003cinput data-field=\"author\"\u003e\u003c/label\u003e\u003clabel\u003e插件版本\u003cinput data-field=\"version\"\u003e\u003c/label\u003e\u003clabel\u003e连接方式\u003cselect data-field=\"transport\"\u003e\u003coption value=\"usb-hid\"\u003eUSB / HID\u003c/option\u003e\u003coption value=\"usb-vendor\"\u003eUSB 厂商协议\u003c/option\u003e\u003coption value=\"bluetooth\"\u003e蓝牙\u003c/option\u003e\u003coption value=\"audio-endpoint\"\u003e音频端点 / 3.5 mm\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003cdiv class=\"fields\"\u003e\u003clabel\u003eVID\u003cinput data-field=\"vid\" maxlength=\"4\" placeholder=\"例如 24AE\"\u003e\u003c/label\u003e\u003clabel\u003ePID\u003cinput data-field=\"pid\" maxlength=\"4\" placeholder=\"例如 1421\"\u003e\u003c/label\u003e\u003c/div\u003e\u003c/div\u003e\n \u003cdiv class=\"actions\"\u003e\u003cbutton data-action=\"save\"\u003e保存项目文件\u003c/button\u003e\u003clabel\u003e恢复项目\u003cinput type=\"file\" data-file=\"project\" accept=\".json\"\u003e\u003c/label\u003e\u003c/div\u003e\n \u003ch2\u003e页面模板与自定义 UI\u003c/h2\u003e\u003cp\u003e模板中的范围是设计起点，请按型号核实。数值变化只预览页面，不代表硬件已接受。\u003c/p\u003e\u003cdiv data-preview=\"controls\" class=\"preview\"\u003e\u003c/div\u003e\n \u003clabel\u003e控件定义 JSON\u003ctextarea data-editor=\"controls\"\u003e\u003c/textarea\u003e\u003c/label\u003e\u003cdiv class=\"actions\"\u003e\u003cbutton data-action=\"controls\"\u003e应用控件定义\u003c/button\u003e\u003cbutton data-action=\"custom-button\"\u003e增加自定义按钮\u003c/button\u003e\u003c/div\u003e\n \u003clabel\u003e作者自己的 HTML 页面（可选）\u003ctextarea data-editor=\"html\" placeholder=\"填写你自己的页面 HTML；留空使用预设控件\"\u003e\u003c/textarea\u003e\u003c/label\u003e\u003cbutton data-action=\"html\"\u003e预览自定义页面\u003c/button\u003e\u003ciframe title=\"自定义 UI 预览\" sandbox=\"allow-scripts\" hidden\u003e\u003c/iframe\u003e\n \u003ch2\u003e官方驱动与抓包对照\u003c/h2\u003e\u003cp\u003e在官方驱动中每次只改一个参数，记录修改前后值。使用 USBPcap / Wireshark 采集目标设备，导出带 usb.capdata 的 JSON，或 payload 列的 CSV / 十六进制文本后导入。无线接收器需确认设备与通道；3.5 mm 耳机没有独立 USB 控制通道。\u003c/p\u003e\n \u003cdiv class=\"fields\"\u003e\u003clabel\u003e修改前的报文\u003cinput type=\"file\" data-file=\"before\" accept=\".json,.csv,.txt\"\u003e\u003c/label\u003e\u003clabel\u003e修改后的报文\u003cinput type=\"file\" data-file=\"after\" accept=\".json,.csv,.txt\"\u003e\u003c/label\u003e\u003clabel\u003e修改前报文序号（从 0 开始）\u003cinput type=\"number\" data-index=\"before\" min=\"0\" value=\"0\"\u003e\u003c/label\u003e\u003clabel\u003e修改后报文序号（从 0 开始）\u003cinput type=\"number\" data-index=\"after\" min=\"0\" value=\"0\"\u003e\u003c/label\u003e\u003c/div\u003e\u003cbutton data-action=\"compare\"\u003e比较报文\u003c/button\u003e\u003cpre data-output=\"diff\"\u003e等待导入前后抓包\u003c/pre\u003e\n \u003ch2\u003e控件与报文绑定\u003c/h2\u003e\u003cp\u003e选择候选字节后，使用多组官方驱动取值确认字节序、范围、校验与通道。这里仅生成预览报文，不自动推断校验码或发送 USB 命令。\u003c/p\u003e\n \u003cdiv class=\"fields\"\u003e\u003clabel\u003e控件\u003cselect data-binding=\"control\"\u003e\u003c/select\u003e\u003c/label\u003e\u003clabel\u003e字节偏移（从 0 开始）\u003cinput data-binding=\"offset\" type=\"number\" min=\"0\" value=\"0\"\u003e\u003c/label\u003e\u003clabel\u003e字节宽度\u003cselect data-binding=\"width\"\u003e\u003coption value=\"1\"\u003e1 字节\u003c/option\u003e\u003coption value=\"2\"\u003e2 字节\u003c/option\u003e\u003coption value=\"4\"\u003e4 字节\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003clabel\u003e字节序\u003cselect data-binding=\"endian\"\u003e\u003coption value=\"little\"\u003e小端\u003c/option\u003e\u003coption value=\"big\"\u003e大端\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003clabel\u003e预览编码值\u003cinput data-binding=\"value\" type=\"number\" min=\"0\" value=\"0\"\u003e\u003c/label\u003e\u003c/div\u003e\n \u003clabel\u003e基础报文\u003ctextarea data-binding=\"base\" placeholder=\"例如 01 00 40 06 00 00\"\u003e\u003c/textarea\u003e\u003c/label\u003e\u003cdiv class=\"actions\"\u003e\u003cbutton data-action=\"encode\"\u003e预览编码报文\u003c/button\u003e\u003cbutton data-action=\"bind\"\u003e保存绑定\u003c/button\u003e\u003cbutton data-action=\"clear-bindings\"\u003e清空绑定\u003c/button\u003e\u003c/div\u003e\u003cpre data-output=\"bindings\"\u003e尚无绑定\u003c/pre\u003e\n \u003ch2\u003e验证与导出\u003c/h2\u003e\u003clabel class=\"check\"\u003e\u003cinput type=\"checkbox\" data-field=\"protocolConfirmed\"\u003e已通过多组官方驱动抓包重复核对绑定，并记录设备型号 / 固件与通道\u003c/label\u003e\u003cp\u003e导出包包含页面定义、设备匹配和协议绑定。真实设备 Worker、权限接口、回读与断线恢复需在代码实现后真机验收；开发包导入主程序不会直接控制硬件。\u003c/p\u003e\u003cbutton class=\"primary\" data-action=\"export\"\u003e导出开发插件 .hhub\u003c/button\u003e\u003cdiv role=\"status\" class=\"status\" aria-live=\"polite\"\u003e\u003c/div\u003e\u003c/div\u003e`;\n document.querySelector(\u0027#environments\u0027).append(detail);\n if(template.kind===\u0027mouse\u0027){\n const entry=document.createElement(\u0027div\u0027);entry.className=\u0027preview\u0027;entry.style.cssText=\u0027padding:0;border:0;margin:0 0 16px\u0027;\n entry.innerHTML=\u0027\u003cbutton type=\"button\" style=\"margin:0 0 12px\"\u003e展开鼠标页面\u003c/button\u003e\u0027;\n const frame=document.createElement(\u0027iframe\u0027);frame.title=\u0027雷柏 VT3S MAX 插件页面\u0027;frame.hidden=true;frame.style.height=\u0027720px\u0027;entry.append(frame);\n entry.querySelector(\u0027button\u0027).onclick=()=\u003e{frame.hidden=!frame.hidden;entry.querySelector(\u0027button\u0027).textContent=frame.hidden?\u0027展开鼠标页面\u0027:\u0027收起鼠标页面\u0027;if(!frame.srcdoc)frame.srcdoc=window.hhubRapooTemplate||\u0027\u003cp\u003e请运行 build-plugin.ps1 生成包含雷柏页面的开发者包。\u003c/p\u003e\u0027;};\n detail.querySelector(\u0027.environment\u0027).prepend(entry);\n }\n let p=HhubDev.project(template.kind),captures={before:[],after:[]};\n if(saved[template.kind]?.kind===template.kind){try{HhubDev.validateControls(saved[template.kind].controls);p=saved[template.kind]}catch{}}\n const el=selector=\u003edetail.querySelector(selector),status=(message,error=false)=\u003e{el(\u0027.status\u0027).textContent=message;el(\u0027.status\u0027).classList.toggle(\u0027error\u0027,error);};\n function persist(){saved[template.kind]=p;try{localStorage.setItem(\u0027hhub.developer.projects\u0027,JSON.stringify(saved))}catch{status(\u0027浏览器存储不可用，请保存项目文件\u0027)}}\n function read(){for(const field of detail.querySelectorAll(\u0027[data-field]\u0027))p[field.dataset.field]=field.type===\u0027checkbox\u0027?field.checked:field.value.trim();p.customUi=el(\u0027[data-editor=html]\u0027).value;if(detail.mouseSync)detail.mouseSync();return p;}\n function preview(){\n   const box=el(\u0027[data-preview=controls]\u0027);box.replaceChildren();const options=el(\u0027[data-binding=control]\u0027);options.replaceChildren();\n   for(const c of p.controls){const label=document.createElement(\u0027label\u0027);label.textContent=c.label;const input=document.createElement(c.type===\u0027button\u0027?\u0027button\u0027:\u0027input\u0027);input.setAttribute(\u0027aria-label\u0027,c.label+\u0027预览\u0027);\n    if(c.type===\u0027button\u0027){input.textContent=c.label;input.onclick=()=\u003estatus(c.label+\u0027：页面事件已触发，未发送设备命令\u0027);}\n    else{input.type=c.type===\u0027toggle\u0027?\u0027checkbox\u0027:\u0027number\u0027;if(c.type===\u0027toggle\u0027)input.checked=c.value;else{input.min=c.min;input.max=c.max;input.value=c.value;}input.onchange=()=\u003e{c.value=c.type===\u0027toggle\u0027?input.checked:Number(input.value);persist();};}\n    label.append(input);box.append(label);const option=document.createElement(\u0027option\u0027);option.value=c.id;option.textContent=c.label;options.append(option);\n   }el(\u0027[data-editor=controls]\u0027).value=JSON.stringify(p.controls,null,2);el(\u0027[data-output=bindings]\u0027).textContent=JSON.stringify(p.bindings,null,2);\n }\n function fill(){if(detail.mouseFill)detail.mouseFill();for(const field of detail.querySelectorAll(\u0027[data-field]\u0027)){if(field.type===\u0027checkbox\u0027)field.checked=!!p[field.dataset.field];else field.value=p[field.dataset.field]||\u0027\u0027;}el(\u0027[data-editor=html]\u0027).value=p.customUi||\u0027\u0027;preview();}\n function binding(){const b={usagePage:el(\u0027[data-binding=base]\u0027).dataset.usagePage||\u0027\u0027,usage:el(\u0027[data-binding=base]\u0027).dataset.usage||\u0027\u0027,control:el(\u0027[data-binding=control]\u0027).value,base:el(\u0027[data-binding=base]\u0027).value,offset:Number(el(\u0027[data-binding=offset]\u0027).value),width:Number(el(\u0027[data-binding=width]\u0027).value),endian:el(\u0027[data-binding=endian]\u0027).value,endpoint:el(\u0027[data-binding=base]\u0027).dataset.endpoint||\u0027\u0027,direction:el(\u0027[data-binding=base]\u0027).dataset.direction||\u0027\u0027,reportId:el(\u0027[data-binding=base]\u0027).dataset.reportId||\u0027\u0027,connectionId:p.currentConnection||\u0027default\u0027,firmware:p.firmware||\u0027\u0027,deviceVersion:p.deviceVersion||\u0027\u0027};return b;}\n if(window.HhubMouse||typeof HhubMouse!==\u0027undefined\u0027)HhubMouse.mount(detail,()=\u003ep,read,status,preview);\n for(const field of detail.querySelectorAll(\u0027[data-field], [data-editor=html]\u0027))field.addEventListener(\u0027change\u0027,()=\u003e{read();persist();});\n for(const input of detail.querySelectorAll(\u0027[data-file]\u0027))input.addEventListener(\u0027change\u0027,async()=\u003e{try{const file=input.files[0];if(!file)return;if(file.size\u003e2*1024*1024)throw Error(\u0027文件不能超过 2 MB\u0027);const text=await file.text();const kind=input.dataset.file;\n   if(kind===\u0027project\u0027){const loaded=JSON.parse(text);if(loaded.kind!==template.kind||loaded.schemaVersion!==1)throw Error(\u0027项目类型 / 格式不匹配\u0027);HhubDev.validateControls(loaded.controls);if(!Array.isArray(loaded.bindings))throw Error(\u0027项目绑定格式不匹配\u0027);p=loaded;fill();persist();status(\u0027项目已恢复\u0027);}\n   else{const imported=HhubDev.parseCapture(text);if(p.kind===\u0027mouse\u0027\u0026\u0026p.vid\u0026\u0026p.pid){for(const frame of imported){if(frame.vid!==undefined\u0026\u0026Number(frame.vid)!==parseInt(p.vid,16)||frame.pid!==undefined\u0026\u0026Number(frame.pid)!==parseInt(p.pid,16))throw Error(\u0027抓包 VID / PID 与当前连接配置不一致\u0027);}}captures[kind]=imported;status(file.name+\u0027：已导入 \u0027+captures[kind].length+\u0027 条报文\u0027);}\n }catch(error){status(error.message,true)}});\n for(const button of detail.querySelectorAll(\u0027[data-action]\u0027))button.addEventListener(\u0027click\u0027,()=\u003e{try{read();const action=button.dataset.action;\n  if(action===\u0027save\u0027){download((p.id||template.kind)+\u0027.hhub-project.json\u0027,p);status(\u0027项目文件已准备下载\u0027);}\n  else if(action===\u0027controls\u0027){p.controls=HhubDev.validateControls(JSON.parse(el(\u0027[data-editor=controls]\u0027).value));preview();status(\u0027页面控件已应用\u0027);}\n  else if(action===\u0027custom-button\u0027){let i=1;while(p.controls.some(c=\u003ec.id===\u0027custom\u0027+i))i++;p.controls.push({id:\u0027custom\u0027+i,label:\u0027自定义按钮 \u0027+i,type:\u0027button\u0027});HhubDev.validateControls(p.controls);preview();status(\u0027自定义按钮已添加，可修改名称并绑定协议\u0027);}\n  else if(action===\u0027html\u0027){const iframe=el(\u0027iframe\u0027);iframe.hidden=false;iframe.srcdoc=\u0027\u003cmeta http-equiv=\"Content-Security-Policy\" content=\"default-src \\\u0027none\\\u0027; script-src \\\u0027unsafe-inline\\\u0027; style-src \\\u0027unsafe-inline\\\u0027; img-src data:; connect-src \\\u0027none\\\u0027\"\u003e\u0027+p.customUi;status(\u0027自定义页面已在隔离预览中加载\u0027);}\n  else if(action===\u0027compare\u0027){const before=captures.before[Number(el(\u0027[data-index=before]\u0027).value)],after=captures.after[Number(el(\u0027[data-index=after]\u0027).value)];if(!before||!after)throw Error(\u0027先导入前后文件并选择有效报文序号\u0027);const result=HhubDev.compare(before,after);el(\u0027[data-output=diff]\u0027).textContent=(result.identityConfirmed?\u0027同通道候选差异\u0027:\u0027缺少通道身份，需人工确认这两条报文对应同一操作\u0027)+\u0027\\n\u0027+result.changes.map(c=\u003e\u0027偏移 \u0027+c.offset+\u0027: \u0027+HhubDev.format([c.before])+\u0027 → \u0027+HhubDev.format([c.after])).join(\u0027\\n\u0027);el(\u0027[data-binding=base]\u0027).value=before.payload;Object.assign(el(\u0027[data-binding=base]\u0027).dataset,{endpoint:before.endpoint,direction:before.direction,reportId:before.reportId,usagePage:before.usagePage??\u0027\u0027,usage:before.usage??\u0027\u0027});status(result.changes.length+\u0027 个字节变化；需重复取值验证\u0027);}\n  else if(action===\u0027encode\u0027){el(\u0027[data-output=bindings]\u0027).textContent=HhubDev.encode(binding(),Number(el(\u0027[data-binding=value]\u0027).value));status(\u0027预览已生成，没有发送硬件命令\u0027);}\n  else if(action===\u0027bind\u0027){const b=binding();HhubDev.encode(b,Number(el(\u0027[data-binding=value]\u0027).value));p.bindings=p.bindings.filter(old=\u003eold.control!==b.control||old.connectionId!==b.connectionId);p.bindings.push(b);p.protocolConfirmed=false;el(\u0027[data-field=protocolConfirmed]\u0027).checked=false;preview();status(\u0027绑定已保存，需要重新完成协议验证\u0027);}\n  else if(action===\u0027clear-bindings\u0027){p.bindings=[];p.protocolConfirmed=false;el(\u0027[data-field=protocolConfirmed]\u0027).checked=false;preview();status(\u0027绑定已清空\u0027);}\n  else if(action===\u0027export\u0027){const manifest=HhubDev.manifest(p);download(p.id+\u0027-\u0027+p.version+\u0027.hhub\u0027,manifest);status(\u0027开发插件包已准备下载；硬件 Worker 尚需实现和验证\u0027);}\n  persist();\n }catch(error){status(error.message,true)}});\n fill();\n}\n\u003c/script\u003e\u003c/body\u003e\u003c/html\u003e\n"
           },
